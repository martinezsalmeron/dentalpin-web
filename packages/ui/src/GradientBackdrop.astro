---
/*
 * Stripe-inspired angled gradient backdrop.
 * Three soft colour stops, subtle skew, radial mask so edges fade.
 * Respects prefers-reduced-motion (static, no animation anyway).
 */
interface Props {
  variant?: 'hero' | 'subtle' | 'band';
  class?: string;
}
const { variant = 'hero', class: extra = '' } = Astro.props;
---

<div aria-hidden="true" class={`gradient-backdrop gradient-${variant} ${extra}`}></div>

<style>
  .gradient-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .gradient-backdrop::before {
    content: '';
    position: absolute;
    inset: -20% -10%;
    background:
      radial-gradient(60% 55% at 15% 20%, color-mix(in oklab, var(--color-primary) 22%, transparent) 0%, transparent 70%),
      radial-gradient(55% 50% at 85% 10%, color-mix(in oklab, #a78bfa 18%, transparent) 0%, transparent 70%),
      radial-gradient(70% 60% at 55% 95%, color-mix(in oklab, #22d3ee 15%, transparent) 0%, transparent 75%);
    transform: skewY(-6deg);
    transform-origin: top left;
    filter: blur(40px) saturate(1.05);
    opacity: 0.9;
  }

  .gradient-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      transparent 55%,
      var(--color-canvas) 100%
    );
  }

  .gradient-subtle::before {
    opacity: 0.45;
    filter: blur(60px) saturate(0.9);
  }

  .gradient-band {
    height: 420px;
    inset: auto 0 0 0;
  }

  .gradient-band::before {
    inset: -40% -10% 0 -10%;
  }

  :global(.dark) .gradient-backdrop::before {
    opacity: 0.35;
    filter: blur(56px) saturate(0.9);
  }
</style>
