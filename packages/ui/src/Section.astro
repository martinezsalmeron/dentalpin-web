---
interface Props {
  class?: string;
  id?: string;
  maxWidth?: 'narrow' | 'default' | 'wide' | 'full';
  padY?: 'sm' | 'md' | 'lg' | 'xl';
}

const {
  class: extra = '',
  id,
  maxWidth = 'default',
  padY = 'lg',
} = Astro.props;

const widths = {
  narrow: 'max-w-3xl',
  default: 'max-w-6xl',
  wide: 'max-w-7xl',
  full: 'max-w-none',
} as const;

const pads = {
  sm: 'py-10',
  md: 'py-16',
  lg: 'py-24',
  xl: 'py-32',
} as const;
---

<section id={id} class={`relative w-full ${pads[padY]} ${extra}`}>
  <div class={`mx-auto w-full px-6 sm:px-8 ${widths[maxWidth]}`}>
    <slot />
  </div>
</section>
