{
  "name": "dentalpin-web-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Dentalpin marketing site + documentation portal",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @dentalpin/web dev",
    "dev:docs": "pnpm --filter @dentalpin/docs dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @dentalpin/web build",
    "build:docs": "pnpm --filter @dentalpin/docs build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test:e2e": "pnpm --filter @dentalpin/web test:e2e",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.6.3"
  }
}
