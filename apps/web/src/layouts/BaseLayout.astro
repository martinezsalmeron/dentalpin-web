---
import '~/styles/global.css';
import {
  DEFAULT_LOCALE,
  HREFLANG,
  HREFLANG_ALIASES,
  HTML_LANG,
  OG_LOCALE,
  isLocale,
  otherLocales,
  translatePath,
  useTranslations,
} from '~/i18n';
import type { Locale } from '~/i18n';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import LocaleHint from '~/components/LocaleHint.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  locale?: Locale;
  ogImage?: string;
  noindex?: boolean;
  /**
   * Per-locale URLs of this exact content, for pages whose translations
   * `translatePath` cannot derive (blog posts, whose slugs are translated
   * per language). When given, it replaces the derived hreflang set; a
   * locale missing here emits no alternate at all rather than pointing at
   * a page that is not a translation of this one.
   */
  alternates?: { locale: Locale; href: string }[];
}

const rawLocale = Astro.currentLocale ?? DEFAULT_LOCALE;
const locale = isLocale(rawLocale) ? rawLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);

const {
  title = t('meta.title'),
  description = t('meta.description'),
  canonicalPath,
  ogImage = '/og-default.png',
  noindex = false,
  alternates: givenAlternates,
} = Astro.props as Props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.dentalpin.com';
const pathname = canonicalPath ?? new URL(Astro.request.url).pathname;
const canonical = `${site}${pathname}`;
// One <link> per hreflang tag, not per locale: the Mexican page also answers
// for Argentina, Chile, Colombia and Peru, which have no page of their own.
const localeAlternates =
  givenAlternates?.filter((a) => a.locale !== locale) ??
  otherLocales(locale).map((l) => ({ locale: l, href: `${site}${translatePath(pathname, l)}` }));
const alternates = localeAlternates.flatMap((a) =>
  [HREFLANG[a.locale], ...(HREFLANG_ALIASES[a.locale] ?? [])].map((hreflang) => ({
    hreflang,
    href: a.href,
  }))
);
const selfHreflangs = [HREFLANG[locale], ...(HREFLANG_ALIASES[locale] ?? [])];
// x-default is the same content in the default language, not the home page.
const xDefault = givenAlternates
  ? (locale === DEFAULT_LOCALE ? canonical : localeAlternates.find((a) => a.locale === DEFAULT_LOCALE)?.href)
  : `${site}${translatePath(pathname, DEFAULT_LOCALE)}`;
const ogFull = ogImage.startsWith('http') ? ogImage : `${site}${ogImage}`;

const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Dentalpin',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description,
  url: site,
  // The software itself is free and open source; hosting is what's sold.
  offers: { '@type': 'Offer', category: 'SaaS', price: '0', priceCurrency: 'EUR' },
  provider: {
    '@type': 'Organization',
    name: 'Dentalpin',
    url: site,
  },
};
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FBFAF8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161513" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    {selfHreflangs.map((h) => <link rel="alternate" hreflang={h} href={canonical} />)}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Dentalpin"
      href={`${site}/${locale}/rss.xml`}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogFull} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Dentalpin" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogFull} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {
      /*
        Cloudflare Web Analytics. Cookieless, so no consent banner and no
        contradiction with the privacy policy, which states this site sets
        strictly necessary cookies only. Anything that sets an analytics
        cookie here needs prior opt-in under LSSI art. 22.2 and a rewrite
        of that policy first.
        Unset token = no beacon, which is what local and preview builds get.
      */
    }
    {beaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      />
    )}
  </head>
  <body class="bg-[var(--color-canvas)] text-[var(--color-text)] antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-[var(--radius-sm)] focus:bg-[var(--color-surface)] focus:px-3 focus:py-2 focus:ring-2 focus:ring-[var(--color-primary)]"
    >
      {t('nav.skip')}
    </a>
    <Nav locale={locale} />
    <LocaleHint locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
