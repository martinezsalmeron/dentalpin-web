---
import { useDict, pagePath, type Locale } from '~/i18n';
import {
  DEMO_URL,
  GITHUB_REPO,
  GITHUB_LICENSE,
  GITHUB_ISSUES,
  GITHUB_CONTRIBUTING,
} from '~/config/links';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = useDict(locale);
const year = new Date().getFullYear();

const demoUrl = DEMO_URL;
const ghUrl = GITHUB_REPO;
const licenseUrl = GITHUB_LICENSE;
---

<footer class="mt-24 border-t border-[var(--color-border-subtle)] bg-[var(--color-surface-muted)]">
  <div class="mx-auto grid max-w-7xl gap-10 px-6 py-14 sm:grid-cols-2 sm:px-8 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <div class="flex items-center gap-2">
        <span aria-hidden="true" style="color:#fff" class="inline-flex h-7 w-7 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--color-primary)] text-white">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 3c-2.5 0-4 2-4 5 0 2 .8 3 1.2 5 .3 1.5.2 3 .6 5 .3 1.5 1 3 2.2 3 1.5 0 1.5-3 2-4.5.3-.9.7-1 1-1s.7.1 1 1c.5 1.5.5 4.5 2 4.5 1.2 0 1.9-1.5 2.2-3 .4-2 .3-3.5.6-5 .4-2 1.2-3 1.2-5 0-3-1.5-5-4-5-1.3 0-2 .7-3 .7s-1.7-.7-3-.7z" />
          </svg>
        </span>
        <span class="text-[15px] font-semibold tracking-tight">Dentalpin</span>
      </div>
      <p class="mt-4 max-w-xs text-[13px] text-[var(--color-text-muted)]">
        {dict.meta.description}
      </p>
      <p class="mt-6 text-[12px] font-medium text-[var(--color-text-muted)]">
        {dict.footer.backedPre}<a href="https://www.dentaltix.com" target="_blank" rel="noopener" class="underline decoration-dotted underline-offset-4 hover:text-[var(--color-primary)]">Dentaltix</a>
      </p>
    </div>

    <div>
      <h3 class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">{dict.footer.product}</h3>
      <ul class="mt-3 space-y-2 text-[14px]">
        <li><a class="hover:text-[var(--color-primary)]" href={pagePath(locale, 'features')}>{dict.footer.links.features}</a></li>
        <li><a class="hover:text-[var(--color-primary)]" href={pagePath(locale, 'pricing')}>{dict.footer.links.pricing}</a></li>
        <li><a class="hover:text-[var(--color-primary)]" href={pagePath(locale, 'manifesto')}>{dict.footer.links.manifesto}</a></li>
        <li><a class="hover:text-[var(--color-primary)]" href={pagePath(locale, 'features', locale === 'en' ? 'modules' : 'modulos')}>{dict.footer.links.modules}</a></li>
        <li><a class="hover:text-[var(--color-primary)]" href={pagePath(locale, 'features', 'api')}>{dict.footer.links.api}</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">{dict.footer.community}</h3>
      <ul class="mt-3 space-y-2 text-[14px]">
        <li><a class="hover:text-[var(--color-primary)]" href={ghUrl} target="_blank" rel="noopener">{dict.footer.links.github}</a></li>
        <li><a class="hover:text-[var(--color-primary)]" href={GITHUB_ISSUES} target="_blank" rel="noopener">{dict.footer.links.issues}</a></li>
        <li><a class="hover:text-[var(--color-primary)]" href={GITHUB_CONTRIBUTING} target="_blank" rel="noopener">{dict.footer.links.contribute}</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">{dict.footer.resources}</h3>
      <ul class="mt-3 space-y-2 text-[14px]">
        <li><a class="hover:text-[var(--color-primary)]" href={demoUrl} target="_blank" rel="noopener">{dict.footer.links.demo}</a></li>
        <li><a class="hover:text-[var(--color-primary)]" href={licenseUrl} target="_blank" rel="noopener">{dict.footer.links.license}</a></li>
        <li><a class="hover:text-[var(--color-primary)]" href={pagePath(locale, 'legalPrivacy')}>{dict.footer.links.privacy}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-[var(--color-border-subtle)]">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-2 px-6 py-4 text-[12px] text-[var(--color-text-muted)] sm:flex-row sm:items-center sm:px-8">
      <span>© {year} Dentalpin. {dict.footer.rights}</span>
      <span>Built open, built calm.</span>
    </div>
  </div>
</footer>
