---
import { useDict, type Locale } from '~/i18n';
import Section from '@dentalpin/ui/Section.astro';
import ModularOrbit from './ModularOrbit.astro';
import { GITHUB_REPO } from '~/config/links';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);
---

<Section id="modular" padY="xs">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-center">
    <div class="max-w-xl">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
        {dict.modular.eyebrow}
      </p>
      <h2 class="text-marketing-h1 mt-3 text-[var(--color-text)]">
        {dict.modular.title}
      </h2>
      <p class="mt-5 text-[15px] leading-[1.7] text-[var(--color-text-muted)]">
        {dict.modular.body}
      </p>

      <ul class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-[12px] text-[var(--color-text-muted)]">
        <li class="inline-flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-primary)]"></span>
          {dict.modular.legend.official}
        </li>
        <li class="inline-flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full border border-dashed border-[var(--color-primary)]"></span>
          {dict.modular.legend.community}
        </li>
        <li class="inline-flex items-center gap-2">
          <span style="color:#fff" class="inline-flex h-2.5 w-2.5 items-center justify-center rounded-full bg-[var(--color-primary)] text-[8px] font-bold text-white">+</span>
          {dict.modular.legend.yours}
        </li>
      </ul>

      <a
        href={GITHUB_REPO}
        target="_blank"
        rel="noopener"
        class="mt-7 inline-flex items-center gap-1 text-[14px] font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-hover)]"
      >
        {dict.modular.cta}
      </a>
    </div>

    <ModularOrbit locale={locale} />
  </div>
</Section>
