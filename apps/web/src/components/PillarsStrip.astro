---
import { useDict, type Locale } from '~/i18n';
import Section from '@dentalpin/ui/Section.astro';
import Icon from '@dentalpin/ui/Icon.astro';
import ClinicDataDiagram from './infographics/ClinicDataDiagram.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);
const items = dict.pillars.items;
---

<Section id="pillars" padY="md">
  <div class="max-w-2xl">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
      {dict.pillars.eyebrow}
    </p>
    <h2 class="text-marketing-h1 mt-3 text-[var(--color-text)]">
      {dict.pillars.title}
    </h2>
    <p class="mt-4 text-[15px] text-[var(--color-text-muted)]">
      {dict.pillars.lead}
    </p>
  </div>

  <ul class="mt-12 grid gap-5 lg:grid-cols-3">
    {items.map((item, idx) => (
      <li class="group relative flex flex-col rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7 shadow-[var(--shadow-xs)] transition-all hover:-translate-y-0.5 hover:border-[var(--color-border-strong)] hover:shadow-[var(--shadow-md)] sm:p-8">
        <span class="inline-flex w-fit items-center gap-2 rounded-[var(--radius-pill)] border border-[var(--color-primary)] bg-[var(--color-primary-soft)] px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary-soft-text)]">
          <span class="font-mono tabular-nums">0{idx + 1}</span>
          <span class="h-3 w-px bg-[var(--color-primary)] opacity-50"></span>
          {item.label}
        </span>

        <h3 class="mt-5 text-[20px] font-semibold leading-[1.25] tracking-[-0.01em] text-[var(--color-text)] sm:text-[22px]">
          {item.title}
        </h3>
        <p class="mt-3 text-[14.5px] leading-[1.6] text-[var(--color-text-muted)]">
          {item.body}
        </p>

        <!-- Mini-infografía por pilar -->
        <div class="mt-6 flex flex-1 items-end">
          {item.key === 'yours' && (
            <div class="w-full overflow-hidden rounded-[var(--radius-lg)] bg-[var(--color-surface-muted)] p-4">
              <ClinicDataDiagram size="sm" locale={locale} class="mx-auto" />
            </div>
          )}
          {item.key === 'modular' && (
            <div class="w-full overflow-hidden rounded-[var(--radius-lg)] bg-[var(--color-surface-muted)] p-4">
              <div class="grid grid-cols-3 gap-2">
                {[true, true, false, true, false, true, true, true, false].map((on) => (
                  <span class:list={[
                    'aspect-square rounded-[var(--radius-sm)] border transition-colors',
                    on
                      ? 'border-[var(--color-primary)] bg-[var(--color-primary-soft)]'
                      : 'border-[var(--color-border-subtle)] bg-[var(--color-surface)] opacity-60',
                  ]}>
                    <span class:list={[
                      'flex h-full w-full items-center justify-center text-[11px] font-bold',
                      on ? 'text-[var(--color-primary)]' : 'text-[var(--color-text-subtle)]',
                    ]}>
                      {on ? '●' : '○'}
                    </span>
                  </span>
                ))}
              </div>
            </div>
          )}
          {item.key === 'open' && (
            <div class="w-full overflow-hidden rounded-[var(--radius-lg)] bg-[var(--color-surface-muted)] p-4">
              <div class="flex items-center justify-center gap-3">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="text-[var(--color-text)]">
                  <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.52 2.87 8.36 6.85 9.71.5.1.68-.22.68-.48v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.57 2.34 1.12 2.91.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.04A9.42 9.42 0 0 1 12 7.1c.85 0 1.7.12 2.5.34 1.9-1.32 2.74-1.04 2.74-1.04.55 1.4.2 2.44.1 2.7.64.71 1.03 1.62 1.03 2.74 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9v2.81c0 .26.18.59.69.48A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2z" />
                </svg>
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-primary)]" aria-hidden="true">
                  <path d="M5 11h14v10H5z" />
                  <path d="M8 11V7a4 4 0 0 1 8 0" />
                </svg>
                <span class="font-mono text-[12px] font-semibold tracking-wider text-[var(--color-primary)]">BSL → APACHE 2.0</span>
              </div>
            </div>
          )}
        </div>

        <a
          href={item.anchor}
          class="mt-6 inline-flex items-center gap-1.5 text-[13px] font-semibold text-[var(--color-primary)] transition-colors hover:text-[var(--color-primary-hover)]"
        >
          {item.linkLabel}
          <span class="transition-transform group-hover:translate-x-0.5">
            <Icon name="arrow-right" size={13} />
          </span>
        </a>
      </li>
    ))}
  </ul>
</Section>
