---
import { useDict, type Locale } from '~/i18n';
import Section from '@dentalpin/ui/Section.astro';
import Icon from '@dentalpin/ui/Icon.astro';
import ClinicDataDiagram from './infographics/ClinicDataDiagram.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);
const items = dict.promises.items;
---

<Section id="promises" padY="md">
  <div class="max-w-2xl">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
      {dict.promises.eyebrow}
    </p>
    <h2 class="text-marketing-h1 mt-3 text-[var(--color-text)]">
      {dict.promises.title}
    </h2>
    <p class="mt-4 text-[15px] text-[var(--color-text-muted)]">
      {dict.promises.lead}
    </p>
  </div>

  <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
    {items.map((item) => (
      <li class="group relative flex flex-col rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 shadow-[var(--shadow-xs)] transition-all hover:-translate-y-0.5 hover:border-[var(--color-border-strong)] hover:shadow-[var(--shadow-md)] sm:p-7">
        <span class="inline-flex w-fit items-center gap-2 rounded-[var(--radius-pill)] border border-[var(--color-primary)] bg-[var(--color-primary-soft)] px-2.5 py-0.5 text-[10.5px] font-semibold uppercase tracking-[0.16em] text-[var(--color-primary-soft-text)]">
          {item.label}
        </span>

        <h3 class="mt-4 text-[19px] font-semibold leading-[1.25] tracking-[-0.01em] text-[var(--color-text)] sm:text-[20px]">
          {item.title}
        </h3>
        <p class="mt-3 text-[14px] leading-[1.6] text-[var(--color-text-muted)]">
          {item.body}
        </p>

        <div class="mt-6 flex flex-1 items-end">
          {item.key === 'yours' && (
            <div class="w-full overflow-hidden rounded-[var(--radius-lg)] bg-[var(--color-surface-muted)] p-4">
              <ClinicDataDiagram size="sm" locale={locale} class="mx-auto" />
            </div>
          )}

          {item.key === 'price' && (
            <div class="w-full overflow-hidden rounded-[var(--radius-lg)] bg-[var(--color-surface-muted)] p-4">
              <svg viewBox="0 0 220 96" class="w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <defs>
                  <pattern id="pricegrid" width="22" height="22" patternUnits="userSpaceOnUse">
                    <path d="M 22 0 L 0 0 0 22" fill="none" stroke="var(--color-border-subtle)" stroke-width="0.5" opacity="0.5"/>
                  </pattern>
                </defs>
                <rect width="220" height="96" fill="url(#pricegrid)" />
                <g opacity="0.3">
                  <rect x="20" y="78" width="20" height="6" fill="var(--color-text-subtle)"/>
                  <rect x="50" y="68" width="20" height="16" fill="var(--color-text-subtle)"/>
                  <rect x="80" y="56" width="20" height="28" fill="var(--color-text-subtle)"/>
                  <rect x="110" y="42" width="20" height="42" fill="var(--color-text-subtle)"/>
                  <rect x="140" y="26" width="20" height="58" fill="var(--color-text-subtle)"/>
                  <rect x="170" y="12" width="20" height="72" fill="var(--color-text-subtle)"/>
                </g>
                <line x1="14" y1="60" x2="200" y2="60" stroke="var(--color-primary)" stroke-width="2.5" stroke-linecap="round"/>
                <circle cx="200" cy="60" r="4" fill="var(--color-primary)"/>
                <text x="14" y="50" font-family="ui-monospace, monospace" font-size="14" font-weight="700" fill="var(--color-primary)">0 €</text>
                <text x="170" y="14" font-family="ui-monospace, monospace" font-size="9" font-weight="600" fill="var(--color-text-subtle)" opacity="0.7">legacy</text>
              </svg>
            </div>
          )}

          {item.key === 'open' && (
            <div class="w-full overflow-hidden rounded-[var(--radius-lg)] bg-[var(--color-surface-muted)] p-4">
              <div class="grid grid-cols-4 gap-1.5">
                {[true, true, false, true, true, false, true, true, false, true, true, true].map((on) => (
                  <span class:list={[
                    'aspect-square rounded-[var(--radius-sm)] border transition-colors',
                    on
                      ? 'border-[var(--color-primary)] bg-[var(--color-primary-soft)]'
                      : 'border-[var(--color-border-subtle)] bg-[var(--color-surface)] opacity-50',
                  ]}>
                    <span class:list={[
                      'flex h-full w-full items-center justify-center text-[10px] font-bold',
                      on ? 'text-[var(--color-primary)]' : 'text-[var(--color-text-subtle)]',
                    ]}>
                      {on ? '●' : '○'}
                    </span>
                  </span>
                ))}
              </div>
            </div>
          )}

          {item.key === 'ux' && (
            <div class="w-full overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[#161513] p-3">
              <div class="flex items-center gap-1.5 border-b border-white/5 pb-2">
                <span class="h-1.5 w-1.5 rounded-full bg-[#ff5f57]"></span>
                <span class="h-1.5 w-1.5 rounded-full bg-[#febc2e]"></span>
                <span class="h-1.5 w-1.5 rounded-full bg-[#28c840]"></span>
                <span class="ml-2 font-mono text-[9px] uppercase tracking-wider text-white/30">Dentalpin</span>
              </div>
              <div class="mt-2.5 space-y-1.5">
                <div class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]"></span>
                  <span class="h-1.5 w-14 rounded-full bg-white/15"></span>
                  <span class="ml-auto h-1.5 w-7 rounded-full bg-white/8"></span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-white/20"></span>
                  <span class="h-1.5 w-20 rounded-full bg-white/12"></span>
                  <span class="ml-auto h-1.5 w-5 rounded-full bg-white/8"></span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-white/20"></span>
                  <span class="h-1.5 w-16 rounded-full bg-white/12"></span>
                  <span class="ml-auto h-1.5 w-9 rounded-full bg-white/8"></span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-white/20"></span>
                  <span class="h-1.5 w-12 rounded-full bg-white/12"></span>
                  <span class="ml-auto h-1.5 w-6 rounded-full bg-white/8"></span>
                </div>
              </div>
            </div>
          )}
        </div>

        <a
          href={item.anchor}
          class="mt-6 inline-flex items-center gap-1.5 text-[13px] font-semibold text-[var(--color-primary)] transition-colors hover:text-[var(--color-primary-hover)]"
        >
          {item.linkLabel}
          <span class="transition-transform group-hover:translate-x-0.5">
            <Icon name="arrow-right" size={13} />
          </span>
        </a>
      </li>
    ))}
  </ul>
</Section>
