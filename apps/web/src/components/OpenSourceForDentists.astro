---
import { useDict, type Locale } from '~/i18n';
import Section from '@dentalpin/ui/Section.astro';
import Button from '@dentalpin/ui/Button.astro';
import OpenSourceFlow from './infographics/OpenSourceFlow.astro';
import { GITHUB_REPO } from '~/config/links';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);
const o = dict.openSourceDentists;
---

<Section id="open-source" padY="md">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-16">
    <header>
      <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
        {o.eyebrow}
      </p>
      <h2 class="mt-3 text-[clamp(1.75rem,2vw+1rem,2.75rem)] font-semibold leading-[1.1] tracking-[-0.015em] text-[var(--color-text)]">
        {o.title}
      </h2>
      <p class="mt-5 text-[16px] leading-[1.65] text-[var(--color-text-muted)]">
        {o.lead}
      </p>

      <div class="mt-8">
        <Button href={GITHUB_REPO} size="lg" variant="solid">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.52 2.87 8.36 6.85 9.71.5.1.68-.22.68-.48v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.57 2.34 1.12 2.91.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.04A9.42 9.42 0 0 1 12 7.1c.85 0 1.7.12 2.5.34 1.9-1.32 2.74-1.04 2.74-1.04.55 1.4.2 2.44.1 2.7.64.71 1.03 1.62 1.03 2.74 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9v2.81c0 .26.18.59.69.48A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2z" />
          </svg>
          {o.ctaLabel}
        </Button>
      </div>

      <div class="mt-12 hidden lg:block">
        <OpenSourceFlow locale={locale} />
      </div>
    </header>

    <ol class="space-y-5">
      {o.items.map((item, idx) => (
        <li class="rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7 shadow-[var(--shadow-xs)] transition-all hover:border-[var(--color-border-strong)] hover:shadow-[var(--shadow-sm)] sm:p-8">
          <div class="flex items-baseline gap-4">
            <span class="font-mono text-[12px] tabular-nums tracking-wider text-[var(--color-text-subtle)]">
              {String(idx + 1).padStart(2, '0')}
            </span>
            <span aria-hidden="true" class="h-px flex-1 bg-gradient-to-r from-[var(--color-border)] to-transparent"></span>
          </div>
          <h3 class="mt-4 text-[18px] font-semibold leading-[1.3] tracking-[-0.01em] text-[var(--color-text)]">
            {item.title}
          </h3>
          <p class="mt-3 text-[14.5px] leading-[1.65] text-[var(--color-text-muted)]">
            {item.body}
          </p>
        </li>
      ))}
    </ol>

    <!-- Mobile: flow goes after the list -->
    <div class="lg:hidden">
      <OpenSourceFlow locale={locale} />
    </div>
  </div>
</Section>
