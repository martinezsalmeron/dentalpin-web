---
import { useDict, type Locale } from '~/i18n';
import Section from '@dentalpin/ui/Section.astro';
import Icon from '@dentalpin/ui/Icon.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);
const section = dict.dayInClinic;

/*
  Three scenes on the homepage, not six.

  All six stay in the i18n file — nothing is lost and this is one number
  to change. But six scenes rendered at 3156px made this 30% of the whole
  page, more than twice what the AI agent got, to argue something every
  competitor can also claim. These three cover reception, chairside and
  out-of-hours, which is the full range the deleted `WhereYouWork`
  section used to argue in the abstract.
*/
const scenes = section.scenes.slice(0, 3);
---

<Section id="day-in-clinic" padY="md">
  <div class="max-w-3xl">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
      {section.eyebrow}
    </p>
    <h2 class="text-marketing-h1 mt-3 text-[var(--color-text)]">
      {section.title}
    </h2>
    <p class="mt-4 text-[16px] leading-[1.65] text-[var(--color-text-muted)]">
      {section.lead}
    </p>
  </div>

  <ol class="mt-14 space-y-16 lg:space-y-24">
    {scenes.map((scene, idx) => {
      const imageFirst = idx % 2 === 0;
      return (
        <li class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-14">
          <figure class:list={[
            'relative overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface-muted)] shadow-[var(--shadow-md)]',
            imageFirst ? 'lg:order-1' : 'lg:order-2',
          ]}>
            <img
              src={`/scenes/${scene.image}`}
              alt={scene.imageAlt}
              loading="lazy"
              decoding="async"
              class="block h-full w-full object-cover"
              style="aspect-ratio: 4 / 3"
            />
          </figure>

          <div class:list={[imageFirst ? 'lg:order-2' : 'lg:order-1']}>
            <div class="flex items-center gap-3">
              <span class="inline-flex h-7 w-7 flex-none items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] font-mono text-[11px] font-semibold tabular-nums tracking-tight text-[var(--color-text-muted)] shadow-[var(--shadow-xs)]">
                {String(idx + 1).padStart(2, '0')}
              </span>
              <span class="inline-flex items-center gap-1.5 rounded-[var(--radius-pill)] border border-[var(--color-border)] bg-[var(--color-surface)] px-2.5 py-1 font-mono text-[11px] tabular-nums tracking-wider text-[var(--color-text-subtle)]">
                <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]"></span>
                {scene.time}
              </span>
              <span class="h-px flex-1 bg-gradient-to-r from-[var(--color-border)] to-transparent"></span>
            </div>
            <h3 class="mt-4 text-[clamp(1.35rem,1.1vw+1rem,1.85rem)] font-semibold leading-[1.15] tracking-[-0.015em] text-[var(--color-text)]">
              {scene.moment}
            </h3>

            <div class="mt-6 space-y-3">
              <div class="flex items-start gap-3 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface-muted)] p-4">
                <span class="mt-0.5 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-subtle)]">
                  <Icon name="close" size={12} />
                </span>
                <div class="min-w-0">
                  <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-text-subtle)]">
                    {section.legacyLabel}
                  </p>
                  <p class="mt-1 text-[15px] leading-[1.55] text-[var(--color-text-muted)]">
                    {scene.legacy}
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-3 rounded-[var(--radius-lg)] border-[1.5px] border-[var(--color-primary)] bg-[var(--color-surface)] p-4 shadow-[var(--shadow-xs)]">
                <span class="mt-0.5 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-[var(--color-primary)] text-white" style="color:#fff">
                  <Icon name="check" size={12} />
                </span>
                <div class="min-w-0">
                  <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
                    {section.dentalpinLabel}
                  </p>
                  <p class="mt-1 text-[15px] leading-[1.55] text-[var(--color-text)]">
                    {scene.dentalpin}
                  </p>
                </div>
              </div>
            </div>
          </div>
        </li>
      );
    })}
  </ol>
</Section>
