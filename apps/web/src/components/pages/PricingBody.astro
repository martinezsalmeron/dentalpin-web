---
import { pagePath, useDict, type Locale } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '@dentalpin/ui/Section.astro';
import Button from '@dentalpin/ui/Button.astro';
import Badge from '@dentalpin/ui/Badge.astro';
import Icon from '@dentalpin/ui/Icon.astro';
import { DEMO_URL, GITHUB_REPO } from '~/config/links';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);

const demoUrl = DEMO_URL;
const ghUrl = GITHUB_REPO;
const privacyHref = `/${locale}/legal/${locale === 'es' ? 'privacidad' : 'privacy'}/`;
---

<BaseLayout locale={locale} title={`${dict.nav.pricing} · Dentalpin`}>
  <Section padY="lg">
    <div class="max-w-2xl">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
        {dict.pricing.eyebrow}
      </p>
      <h1 class="text-marketing-h1 mt-3 text-[var(--color-text)]">
        {dict.pricing.title}
      </h1>
      <p class="mt-4 text-[15px] text-[var(--color-text-muted)]">
        {dict.pricing.subtitle}
      </p>
    </div>

    <div class="mt-12 grid gap-4 lg:grid-cols-2">
      <article class="relative flex flex-col rounded-[var(--radius-xl)] border-[1.5px] border-[var(--color-primary)] bg-[var(--color-surface)] p-8 shadow-[var(--shadow-md)]">
        <div class="flex items-center justify-between">
          <h2 class="text-[20px] font-semibold tracking-tight">{dict.pricing.selfhost.title}</h2>
          <Badge role="primary">{dict.pricing.selfhost.badge}</Badge>
        </div>
        <div class="mt-6">
          <div class="flex items-baseline gap-2">
            <span class="text-[48px] font-bold tracking-tight text-[var(--color-text)]">
              {dict.pricing.selfhost.price}
            </span>
            <span class="text-[14px] text-[var(--color-text-muted)]">{dict.pricing.selfhost.priceSuffix}</span>
          </div>
          <p class="mt-3 text-[14px] text-[var(--color-text-muted)]">{dict.pricing.selfhost.description}</p>
        </div>
        <ul class="mt-6 space-y-2 text-[14px]">
          {dict.pricing.selfhost.features.map((f) => (
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-[var(--color-primary)]"><Icon name="check" size={16} /></span>
              <span class="text-[var(--color-text)]">{f}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8 flex flex-col gap-2 sm:flex-row">
          <Button href={ghUrl} variant="solid" size="md" class="w-full">
            {dict.pricing.selfhost.ctaPrimary}
          </Button>
          <Button href={demoUrl} variant="outline" size="md" class="w-full">
            {dict.pricing.selfhost.ctaSecondary}
          </Button>
        </div>
      </article>

      <article class="relative flex flex-col rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 shadow-[var(--shadow-sm)]">
        <div class="flex items-center justify-between">
          <h2 class="text-[20px] font-semibold tracking-tight">{dict.pricing.cloud.title}</h2>
          <Badge role="warning">{dict.pricing.cloud.badge}</Badge>
        </div>
        <div class="mt-6">
          <div class="flex items-baseline gap-2">
            <span class="text-[40px] font-bold tracking-tight text-[var(--color-text-muted)]">
              {dict.pricing.cloud.price}
            </span>
            <span class="text-[14px] text-[var(--color-text-muted)]">{dict.pricing.cloud.priceSuffix}</span>
          </div>
          <p class="mt-3 text-[14px] text-[var(--color-text-muted)]">{dict.pricing.cloud.description}</p>
        </div>
        <ul class="mt-6 space-y-2 text-[14px]">
          {dict.pricing.cloud.features.map((f) => (
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-[var(--color-text-subtle)]"><Icon name="check" size={16} /></span>
              <span class="text-[var(--color-text-muted)]">{f}</span>
            </li>
          ))}
        </ul>

        <div id="sib-form-container" class="sib-form-container mt-8 border-t border-[var(--color-border-subtle)] pt-6">
          <p class="text-[12px] font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
            {dict.pricing.cloud.formLabel}
          </p>

          <div
            id="error-message"
            class="sib-form-message-panel mt-4 rounded-[var(--radius-md)] border border-[var(--color-danger-accent)] bg-[var(--color-danger-soft)] px-4 py-3 text-[13px] text-[var(--color-danger-text)]"
            style="display:none;"
          >
            <span class="sib-form-message-panel__inner-text">{dict.pricing.cloud.error}</span>
          </div>

          <div
            id="success-message"
            class="sib-form-message-panel mt-4 rounded-[var(--radius-md)] border border-[var(--color-success-accent)] bg-[var(--color-success-soft)] px-4 py-3 text-[13px] text-[var(--color-success-text)]"
            style="display:none;"
          >
            <span class="sib-form-message-panel__inner-text">{dict.pricing.cloud.success}</span>
          </div>

          <div id="sib-container" class="sib-container--large sib-container--vertical">
            <form
              id="sib-form"
              method="POST"
              action="https://3a34dae1.sibforms.com/serve/MUIFALk1qeX5NclOreDHssTr-2MrMSZDLcB_DXQh0eIc7iz1yDm-N-CrbeFQfxdzXbik2SykZriKIfOU4ULDQWMWnyNCBWw-1FpP6hQTeJJiOIsAG9ejUolZcug_EEuY0u5ELXeAOjeNm5dtwXToSA4DIhkyZk35tmNy3dS93f77ovrpFKvdtGlIad4qVoODgxh7_iYOfjvw43HZuA=="
              data-type="subscription"
              class="mt-4 flex flex-col gap-3"
            >
              <div class="sib-input sib-form-block">
                <div class="form__entry entry_block">
                  <div class="form__label-row">
                    <div class="entry__field">
                      <input
                        class="input h-10 w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface-sunken)] px-3 text-[14px] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)] focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] focus:outline-none"
                        type="email"
                        id="EMAIL"
                        name="EMAIL"
                        autocomplete="email"
                        placeholder={dict.pricing.cloud.emailField}
                        data-required="true"
                        required
                      />
                    </div>
                  </div>
                  <label class="entry__error entry__error--primary mt-1 block text-[12px] text-[var(--color-danger-text)]" style="display:none;"></label>
                </div>
              </div>

              <div class="sib-input sib-form-block">
                <div class="form__entry entry_block">
                  <div class="form__label-row">
                    <div class="entry__field">
                      <input
                        class="input h-10 w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface-sunken)] px-3 text-[14px] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)] focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] focus:outline-none"
                        maxlength="200"
                        type="text"
                        id="NOMBRE"
                        name="NOMBRE"
                        autocomplete="organization"
                        placeholder={dict.pricing.cloud.clinicField}
                      />
                    </div>
                  </div>
                  <label class="entry__error entry__error--primary mt-1 block text-[12px] text-[var(--color-danger-text)]" style="display:none;"></label>
                </div>
              </div>

              <div class="sib-optin sib-form-block" data-required="true">
                <div class="form__entry entry_mcq">
                  <label class="flex items-start gap-2 text-[12px] leading-snug text-[var(--color-text-muted)]">
                    <input
                      type="checkbox"
                      class="mt-0.5 h-3.5 w-3.5 flex-none rounded-[var(--radius-xs)] border border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)]"
                      value="1"
                      id="ACEPTA_PRIVACIDAD"
                      name="ACEPTA_PRIVACIDAD"
                      required
                    />
                    <span>
                      {dict.pricing.cloud.consentBefore}<a href={privacyHref} class="underline underline-offset-2 hover:text-[var(--color-primary)]">{dict.pricing.cloud.consentLink}</a>{dict.pricing.cloud.consentAfter}
                    </span>
                  </label>
                  <label class="entry__error entry__error--primary mt-1 block text-[12px] text-[var(--color-danger-text)]" style="display:none;"></label>
                  <p class="mt-1 pl-[1.4rem] text-[11px] text-[var(--color-text-subtle)]">
                    {dict.pricing.cloud.consentNote}
                  </p>
                </div>
              </div>

              <div class="flex justify-end">
                <button
                  form="sib-form"
                  type="submit"
                  class="sib-form-block__button sib-form-block__button-with-loader inline-flex h-9 items-center gap-2 rounded-[var(--radius-sm)] bg-[var(--color-primary)] px-4 text-[13px] font-semibold shadow-[var(--shadow-xs)] hover:bg-[var(--color-primary-hover)]"
                  style="color:#fff;"
                >
                  <svg class="icon clickable__icon progress-indicator__icon sib-hide-loader-icon" viewBox="0 0 512 512" width="14" height="14" aria-hidden="true">
                    <path fill="currentColor" d="M460.116 373.846l-20.823-12.022c-5.541-3.199-7.54-10.159-4.663-15.874 30.137-59.886 28.343-131.652-5.386-189.946-33.641-58.394-94.896-95.833-161.827-99.676C261.028 55.961 256 50.751 256 44.352V20.309c0-6.904 5.808-12.337 12.703-11.982 83.556 4.306 160.163 50.864 202.11 123.677 42.063 72.696 44.079 162.316 6.031 236.832-3.14 6.148-10.75 8.461-16.728 5.01z" />
                  </svg>
                  {dict.pricing.cloud.submit}
                </button>
              </div>

              <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true" />
              <input type="hidden" name="locale" value={locale} />
            </form>
          </div>
        </div>

        <script
          is:inline
          define:vars={{
            currentLocale: locale,
            invalidMsg: dict.pricing.cloud.error,
            requiredMsg: dict.pricing.cloud.consentRequired,
          }}
        >
          window.REQUIRED_CODE_ERROR_MESSAGE = requiredMsg;
          window.LOCALE = currentLocale;
          window.EMAIL_INVALID_MESSAGE = invalidMsg;
          window.SMS_INVALID_MESSAGE = invalidMsg;
          window.REQUIRED_ERROR_MESSAGE = requiredMsg;
          window.GENERIC_INVALID_MESSAGE = invalidMsg;
          window.translation = {
            common: {
              selectedList: '{quantity} list selected',
              selectedLists: '{quantity} lists selected',
              selectedOption: '{quantity} selected',
              selectedOptions: '{quantity} selected',
            },
          };
          var AUTOHIDE = Boolean(0);
        </script>

        <script is:inline defer src="https://sibforms.com/forms/end-form/build/main.js"></script>
      </article>
    </div>
  </Section>

  <Section padY="md">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
      {dict.pricing.services.eyebrow}
    </p>
    <h2 class="text-marketing-h1 mt-3 text-[var(--color-text)]">
      {dict.pricing.services.title}
    </h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {dict.pricing.services.items.map((s) => (
        <li class="flex flex-col rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 shadow-[var(--shadow-sm)]">
          <h3 class="text-[17px] font-semibold tracking-tight">{s.title}</h3>
          <p class="mt-2 text-[14px] leading-[1.55] text-[var(--color-text-muted)]">{s.body}</p>
          <a
            href={pagePath(locale, 'contact')}
            class="mt-5 inline-flex items-center gap-1 text-[14px] font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-hover)]"
          >
            {dict.pricing.services.cta} →
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section padY="lg" maxWidth="narrow">
    <h2 class="text-marketing-h1 text-[var(--color-text)]">
      {dict.pricing.faq.title}
    </h2>
    <ul class="mt-8 divide-y divide-[var(--color-border-subtle)]">
      {dict.pricing.faq.items.map((item) => (
        <li>
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
              <span class="text-[16px] font-semibold text-[var(--color-text)]">{item.q}</span>
              <span class="mt-1 text-[var(--color-text-muted)] transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-[14px] leading-[1.65] text-[var(--color-text-muted)]" set:html={item.a}></p>
          </details>
        </li>
      ))}
    </ul>
  </Section>

</BaseLayout>
