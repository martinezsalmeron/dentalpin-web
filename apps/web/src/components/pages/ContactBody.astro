---
import { useDict, type Locale } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '@dentalpin/ui/Section.astro';
import Icon from '@dentalpin/ui/Icon.astro';
import ContactForm from '~/components/ContactForm.astro';
import { DEMO_URL, GITHUB_REPO, TELEGRAM_URL } from '~/config/links';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);
const c = dict.contact;

/*
 * The page serves two visitors at once: the one ready to write to us, and
 * the one who wants to poke at something first and would otherwise bounce.
 * The form keeps the weight; the other three doors sit beside it in one
 * rail, so nobody has to go back through the nav to find them.
 */
const rail = [
  { ...c.rail.demo, href: DEMO_URL },
  { ...c.rail.telegram, href: TELEGRAM_URL },
  { ...c.rail.github, href: GITHUB_REPO },
];
---

<BaseLayout locale={locale} title={`${c.title} · Dentalpin`} description={c.subtitle}>
  <Section padY="lg">
    <div class="max-w-2xl">
      <h1 class="text-marketing-h1 text-[var(--color-text)]">{c.title}</h1>
      <p class="mt-4 text-[16px] leading-[1.6] text-[var(--color-text-muted)]">{c.subtitle}</p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:items-start">
      <ContactForm locale={locale} />

      <aside class="flex flex-col gap-3">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
          {c.rail.title}
        </p>
        {rail.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener"
            class="flex flex-col rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 shadow-[var(--shadow-xs)] transition-colors hover:border-[var(--color-primary)]"
          >
            <span class="text-[16px] font-semibold leading-snug text-[var(--color-text)]">
              {item.title}
            </span>
            <span class="mt-1.5 text-[13.5px] leading-[1.55] text-[var(--color-text-muted)]">
              {item.body}
            </span>
            <span class="mt-3 inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-[var(--color-primary)]">
              {item.cta}
              <Icon name="arrow-right" size={13} />
            </span>
          </a>
        ))}
      </aside>
    </div>
  </Section>
</BaseLayout>
