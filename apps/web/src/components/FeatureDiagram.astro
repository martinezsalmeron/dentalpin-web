---
import type { Locale } from '~/i18n';
import ModularOrbit from './ModularOrbit.astro';

interface Props {
  slug: 'modulos' | 'api' | 'ai-ready';
  locale: Locale;
}

const { slug, locale } = Astro.props;
const isEs = locale === 'es';

const apiEndpoints = [
  { method: 'GET', path: '/api/v1/patients', tone: 'get' },
  { method: 'POST', path: '/api/v1/patients', tone: 'post' },
  { method: 'GET', path: '/api/v1/appointments', tone: 'get' },
  { method: 'POST', path: '/api/v1/appointments', tone: 'post' },
  { method: 'PATCH', path: '/api/v1/budgets/{id}', tone: 'patch' },
  { method: 'POST', path: '/api/v1/invoices', tone: 'post' },
  { method: 'GET', path: '/api/v1/odontogram/{patient_id}', tone: 'get' },
  { method: 'POST', path: '/api/v1/webhooks/events', tone: 'post' },
] as const;

const methodClasses: Record<string, string> = {
  get: 'bg-[var(--color-info-soft)] text-[var(--color-info-text)]',
  post: 'bg-[var(--color-success-soft)] text-[var(--color-success-text)]',
  patch: 'bg-[var(--color-warning-soft)] text-[var(--color-warning-text)]',
};

const aiSteps = isEs
  ? [
      { title: 'Agente IA', body: 'Propone una acción (agendar, redactar, cobrar).' },
      { title: 'Tool Registry', body: 'Traduce la intención a una llamada interna segura.' },
      { title: 'Aprobación humana', body: 'Un profesional revisa, ajusta y confirma.' },
      { title: 'Ejecución', body: 'La acción se ejecuta con traza completa.' },
    ]
  : [
      { title: 'AI agent', body: 'Proposes an action (schedule, draft, charge).' },
      { title: 'Tool registry', body: 'Translates intent into a safe internal call.' },
      { title: 'Human approval', body: 'A professional reviews, tweaks, confirms.' },
      { title: 'Execution', body: 'The action runs, with a full audit trail.' },
    ];
---

{slug === 'modulos' && (
  <ModularOrbit locale={locale} />
)}

{slug === 'api' && (
  <figure class="relative overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[var(--shadow-sm)]">
    <header class="flex items-center justify-between gap-4 border-b border-[var(--color-border-subtle)] bg-[var(--color-surface-muted)] px-5 py-3">
      <div class="flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-[color-mix(in_oklab,var(--color-danger-accent)_70%,transparent)]"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[color-mix(in_oklab,var(--color-warning-accent)_70%,transparent)]"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[color-mix(in_oklab,var(--color-success-accent)_70%,transparent)]"></span>
      </div>
      <code class="font-mono text-[12px] tabular-nums text-[var(--color-text-muted)]">api.dentalpin.com/docs</code>
      <span class="inline-flex items-center gap-1.5 rounded-[var(--radius-pill)] border border-[var(--color-border-subtle)] bg-[var(--color-surface)] px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
        OpenAPI 3.1
      </span>
    </header>

    <ul class="divide-y divide-[var(--color-border-subtle)]">
      {apiEndpoints.map((e) => (
        <li class="flex items-center gap-4 px-5 py-3">
          <span class={`w-16 flex-none rounded-[var(--radius-sm)] px-2 py-0.5 text-center font-mono text-[11px] font-semibold tracking-wider ${methodClasses[e.tone]}`}>
            {e.method}
          </span>
          <code class="truncate font-mono text-[13px] text-[var(--color-text)]">{e.path}</code>
          <span class="ml-auto font-mono text-[11px] tabular-nums text-[var(--color-text-subtle)]">200</span>
        </li>
      ))}
    </ul>

    <footer class="flex items-center justify-between gap-3 border-t border-[var(--color-border-subtle)] bg-[var(--color-surface-muted)] px-5 py-3 text-[11px] uppercase tracking-[0.16em] text-[var(--color-text-muted)]">
      <span>JWT · RBAC · {isEs ? 'Misma API que la app web' : 'Same API the web app uses'}</span>
      <span class="font-mono normal-case tracking-normal text-[var(--color-text-subtle)]">+ {isEs ? '120 endpoints más' : '120 more endpoints'}</span>
    </footer>
  </figure>
)}

{slug === 'ai-ready' && (
  <figure class="relative overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 shadow-[var(--shadow-sm)] sm:p-10">
    <ol class="relative grid gap-4 md:grid-cols-4">
      {aiSteps.map((step, idx) => (
        <li class="relative flex flex-col gap-3 rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-muted)] p-5">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] tabular-nums tracking-wider text-[var(--color-text-subtle)]">
              {String(idx + 1).padStart(2, '0')}
            </span>
            {idx === 2 && (
              <span class="rounded-[var(--radius-pill)] bg-[var(--color-primary-soft)] px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-[var(--color-primary-soft-text)]">
                {isEs ? 'Humano al mando' : 'Human in charge'}
              </span>
            )}
          </div>
          <h3 class="text-[15px] font-semibold tracking-tight text-[var(--color-text)]">
            {step.title}
          </h3>
          <p class="text-[13px] leading-[1.55] text-[var(--color-text-muted)]">
            {step.body}
          </p>
          {idx < aiSteps.length - 1 && (
            <span aria-hidden="true" class="pointer-events-none absolute right-[-14px] top-1/2 hidden h-px w-7 -translate-y-1/2 bg-[var(--color-border)] md:block"></span>
          )}
        </li>
      ))}
    </ol>
    <figcaption class="mt-6 text-center text-[12px] uppercase tracking-[0.18em] text-[var(--color-text-muted)]">
      {isEs ? 'La IA propone. El humano aprueba. La plataforma ejecuta.' : 'AI proposes. The human approves. The platform executes.'}
    </figcaption>
  </figure>
)}
