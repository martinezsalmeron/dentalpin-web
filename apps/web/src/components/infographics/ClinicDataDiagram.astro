---
/*
 * Building (clinic) with server inside, data dots confined.
 * External cloud on the right, struck through. Self-host metaphor.
 */
import type { Locale } from '~/i18n';
interface Props {
  size?: 'sm' | 'md';
  class?: string;
  locale?: Locale;
}
const { size = 'md', class: extra = '', locale = 'es' } = Astro.props;
const dim = size === 'sm' ? 120 : 220;
const labelClinic = locale === 'es' ? 'DONDE TÚ ELIJAS' : 'WHERE YOU PICK';
const labelCloud = locale === 'es' ? 'NUBE AJENA' : 'OUTSIDE CLOUD';
---

<svg
  viewBox="0 0 220 140"
  width={dim}
  height={Math.round((dim * 140) / 220)}
  class={`block ${extra}`}
  aria-hidden="true"
  role="presentation"
>
  <!-- Clinic building (left) -->
  <g>
    <!-- roof -->
    <path
      d="M 18 50 L 60 22 L 102 50 Z"
      fill="var(--color-primary-soft)"
      stroke="var(--color-primary)"
      stroke-width="1.25"
      stroke-linejoin="round"
    />
    <!-- body -->
    <rect
      x="22"
      y="50"
      width="76"
      height="70"
      rx="3"
      fill="var(--color-surface)"
      stroke="var(--color-primary)"
      stroke-width="1.25"
    />
    <!-- door -->
    <rect x="52" y="92" width="16" height="28" rx="1.5" fill="var(--color-primary-soft)" stroke="var(--color-primary)" stroke-width="1" />
    <!-- windows -->
    <rect x="32" y="62" width="14" height="14" rx="1" fill="none" stroke="var(--color-border-strong)" stroke-width="1" />
    <rect x="74" y="62" width="14" height="14" rx="1" fill="none" stroke="var(--color-border-strong)" stroke-width="1" />
    <!-- server inside -->
    <g transform="translate(40,84)">
      <rect x="0" y="0" width="40" height="6" rx="1.2" fill="var(--color-primary)" />
      <rect x="0" y="-1" width="40" height="2" rx="1" fill="var(--color-primary)" opacity="0.4" />
      <circle cx="35" cy="3" r="0.8" fill="var(--color-surface)" />
    </g>
    <!-- data dots confined inside -->
    <circle cx="36" cy="105" r="1.6" fill="var(--color-primary)" />
    <circle cx="48" cy="108" r="1.6" fill="var(--color-primary)" />
    <circle cx="60" cy="105" r="1.6" fill="var(--color-primary)" />
    <circle cx="72" cy="108" r="1.6" fill="var(--color-primary)" />
    <circle cx="84" cy="105" r="1.6" fill="var(--color-primary)" />
    <!-- "Tu clínica" label sits on the building itself, drawn in light gray -->
    <text
      x="60"
      y="44"
      text-anchor="middle"
      font-family="Inter, system-ui, sans-serif"
      font-size="7"
      font-weight="600"
      fill="var(--color-primary)"
      letter-spacing="0.05em"
    >{labelClinic}</text>
  </g>

  <!-- Connector showing data does NOT leave -->
  <g>
    <line
      x1="105"
      y1="78"
      x2="135"
      y2="78"
      stroke="var(--color-border-strong)"
      stroke-width="1"
      stroke-dasharray="2 3"
    />
    <!-- crossed out -->
    <line x1="116" y1="68" x2="124" y2="88" stroke="var(--color-danger, #dc2626)" stroke-width="1.5" stroke-linecap="round" />
    <line x1="124" y1="68" x2="116" y2="88" stroke="var(--color-danger, #dc2626)" stroke-width="1.5" stroke-linecap="round" />
  </g>

  <!-- External cloud (right) -->
  <g>
    <path
      d="M 152 70 c -8 0 -14 6 -14 12 c -6 0 -10 4 -10 10 c 0 6 4 10 10 10 l 50 0 c 8 0 14 -6 14 -14 c 0 -8 -6 -14 -14 -14 c 0 -2 -2 -4 -4 -4 c -3 -8 -16 -8 -19 0 c -4 -2 -10 -2 -13 0 z"
      fill="var(--color-surface-muted)"
      stroke="var(--color-border-strong)"
      stroke-width="1"
      opacity="0.7"
    />
    <text
      x="166"
      y="92"
      text-anchor="middle"
      font-family="Inter, system-ui, sans-serif"
      font-size="6.5"
      font-weight="500"
      fill="var(--color-text-subtle)"
      letter-spacing="0.05em"
    >{labelCloud}</text>
  </g>
</svg>
