---
/*
 * Three developer sources (Dentalpin team / your IT person / community)
 * converging into a public repo, then flowing to your clinic install.
 * Plain language: dentists never need to touch code, devs do, the
 * infographic shows that ecosystem visually.
 *
 * Text wrapping is done via foreignObject so long titles/bodies wrap
 * inside the boxes instead of overflowing.
 */
import type { Locale } from '~/i18n';
import { useDict } from '~/i18n';

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: extra = '' } = Astro.props;
const dict = useDict(locale);
const flow = dict.openSourceDentists.flow;
const sources = flow.sources;
const hub = flow.hub;
const dest = flow.destination;
const flowLabel = flow.label;

const sourceBoxes = [
  { y: 8, source: sources[0], strong: true },
  { y: 88, source: sources[1], strong: false },
  { y: 168, source: sources[2], strong: false },
];
---

<figure class={`relative ${extra}`} aria-label={flowLabel}>
  <span class="mb-4 inline-flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--color-text-subtle)]">
    <span class="h-px w-6 bg-[var(--color-border-strong)]"></span>
    {flowLabel}
  </span>

  <svg
    viewBox="0 0 400 260"
    class="block w-full h-auto"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
    role="presentation"
  >
    <defs>
      <marker id="osArrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 Z" fill="var(--color-primary)" />
      </marker>
    </defs>

    {sourceBoxes.map(({ y, source, strong }) => (
      <g>
        <rect
          x="6"
          y={y}
          width="160"
          height="68"
          rx="8"
          fill="var(--color-surface)"
          stroke={strong ? 'var(--color-primary)' : 'var(--color-border-strong)'}
          stroke-width="1.25"
          stroke-dasharray={strong ? undefined : '3 2'}
        />
        <!-- Avatar -->
        <circle
          cx="26"
          cy={y + 22}
          r="9"
          fill={strong ? 'var(--color-primary-soft)' : 'var(--color-surface-muted)'}
          stroke={strong ? 'var(--color-primary)' : 'var(--color-border-strong)'}
          stroke-width="1"
        />
        <path
          d={`M 22 ${y + 22} a 4 4 0 1 0 8 0 a 4 4 0 1 0 -8 0 M 18 ${y + 32} c 0 -4 4 -7 8 -7 s 8 3 8 7`}
          fill="none"
          stroke={strong ? 'var(--color-primary)' : 'var(--color-text-muted)'}
          stroke-width="1.2"
          stroke-linecap="round"
        />
        <!-- Text content (wrappable) -->
        <foreignObject x="42" y={y + 8} width="120" height="56">
          <div
            style="font-family: Inter, system-ui, sans-serif; color: var(--color-text); font-size: 9px; font-weight: 600; line-height: 1.25;"
          >
            {source.title}
          </div>
          <div
            style="font-family: Inter, system-ui, sans-serif; color: var(--color-text-muted); font-size: 8px; line-height: 1.35; margin-top: 3px;"
          >
            {source.body}
          </div>
        </foreignObject>
      </g>
    ))}

    <!-- Curves into hub (recomputed for new y values) -->
    <path d="M 166 42 C 200 42 210 110 230 122" fill="none" stroke="var(--color-primary)" stroke-width="1.25" marker-end="url(#osArrow)" />
    <path d="M 166 122 C 200 122 210 128 230 128" fill="none" stroke="var(--color-primary)" stroke-width="1.25" marker-end="url(#osArrow)" />
    <path d="M 166 202 C 200 202 210 142 230 134" fill="none" stroke="var(--color-primary)" stroke-width="1.25" marker-end="url(#osArrow)" />

    <!-- Hub: public repo -->
    <g>
      <rect x="236" y="100" width="104" height="60" rx="10" fill="var(--color-primary)" />
      <!-- github mark, centered -->
      <g transform="translate(254, 112)">
        <path
          d="M12 2C6.48 2 2 6.58 2 12.25c0 4.52 2.87 8.36 6.85 9.71.5.1.68-.22.68-.48v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.57 2.34 1.12 2.91.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.04A9.42 9.42 0 0 1 12 7.1c.85 0 1.7.12 2.5.34 1.9-1.32 2.74-1.04 2.74-1.04.55 1.4.2 2.44.1 2.7.64.71 1.03 1.62 1.03 2.74 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9v2.81c0 .26.18.59.69.48A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"
          fill="#ffffff"
          transform="scale(0.65)"
        />
      </g>
      <foreignObject x="240" y="135" width="96" height="24">
        <div
          style="font-family: Inter, system-ui, sans-serif; text-align: center; color: #ffffff; font-size: 9px; font-weight: 700;"
        >
          {hub}
        </div>
        <div
          style="font-family: Inter, system-ui, sans-serif; text-align: center; color: rgba(255,255,255,0.85); font-size: 7px; font-weight: 500; margin-top: 1px;"
        >
          github.com/dentalpin
        </div>
      </foreignObject>
    </g>

    <!-- Arrow hub -> destination -->
    <path d="M 340 128 L 360 128" fill="none" stroke="var(--color-primary)" stroke-width="1.5" marker-end="url(#osArrow)" />

    <!-- Destination: clinic + label -->
    <g>
      <path d="M 360 110 L 376 98 L 392 110 Z" fill="var(--color-primary-soft)" stroke="var(--color-primary)" stroke-width="1" stroke-linejoin="round" />
      <rect x="362" y="110" width="28" height="40" rx="2" fill="var(--color-surface)" stroke="var(--color-primary)" stroke-width="1" />
      <rect x="373" y="130" width="6" height="20" rx="0.6" fill="var(--color-primary-soft)" stroke="var(--color-primary)" stroke-width="0.8" />
      <rect x="366" y="116" width="5" height="5" rx="0.5" fill="none" stroke="var(--color-primary)" stroke-width="0.8" />
      <rect x="382" y="116" width="5" height="5" rx="0.5" fill="none" stroke="var(--color-primary)" stroke-width="0.8" />
    </g>
    <foreignObject x="346" y="158" width="56" height="40">
      <div
        style="font-family: Inter, system-ui, sans-serif; text-align: center; color: var(--color-text); font-size: 8px; font-weight: 700; line-height: 1.25;"
      >
        {dest}
      </div>
    </foreignObject>
  </svg>
</figure>
