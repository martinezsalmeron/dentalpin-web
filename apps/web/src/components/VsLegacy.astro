---
import { useDict, type Locale } from '~/i18n';
import Section from '@dentalpin/ui/Section.astro';
import Icon from '@dentalpin/ui/Icon.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);
---

<Section id="vs-legacy" padY="md">
  <div class="max-w-2xl">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
      {dict.vsLegacy.eyebrow}
    </p>
    <h2 class="text-marketing-h1 mt-3 text-[var(--color-text)]">
      {dict.vsLegacy.title}
    </h2>
    <p class="mt-4 text-[15px] text-[var(--color-text-muted)]">
      {dict.vsLegacy.lead}
    </p>
  </div>

  <div class="relative mt-12 grid gap-5 lg:grid-cols-2">
    <article class="relative rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface-muted)] p-7 sm:p-8">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="text-[18px] font-semibold tracking-tight text-[var(--color-text-muted)]">{dict.vsLegacy.legacy.title}</h3>
          <p class="mt-1 text-[13px] text-[var(--color-text-subtle)]">{dict.vsLegacy.legacy.subtitle}</p>
        </div>
        <span class="rounded-[var(--radius-pill)] border border-[var(--color-border)] bg-[var(--color-surface)] px-2.5 py-1 font-mono text-[11px] uppercase tracking-wider text-[var(--color-text-subtle)]">{dict.vsLegacy.legacy.tag}</span>
      </div>
      <ul class="mt-6 space-y-3 text-[14px]">
        {dict.vsLegacy.legacy.bullets.map((b) => (
          <li class="flex items-start gap-3 text-[var(--color-text-muted)]">
            <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-subtle)]">
              <Icon name="close" size={12} />
            </span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </article>

    <article class="relative rounded-[var(--radius-xl)] border-[1.5px] border-[var(--color-primary)] bg-[var(--color-surface)] p-7 shadow-[var(--shadow-md)] sm:p-8">
      <div class="absolute -top-3 left-7 inline-flex rounded-[var(--radius-pill)] bg-[var(--color-primary)] px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-white">
        {dict.vsLegacy.dentalpin.badge}
      </div>
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="text-[18px] font-semibold tracking-tight text-[var(--color-text)]">{dict.vsLegacy.dentalpin.title}</h3>
          <p class="mt-1 text-[13px] text-[var(--color-primary)]">{dict.vsLegacy.dentalpin.subtitle}</p>
        </div>
        <span class="rounded-[var(--radius-pill)] border border-[var(--color-primary)] bg-[var(--color-primary-soft)] px-2.5 py-1 font-mono text-[11px] uppercase tracking-wider text-[var(--color-primary-soft-text)]">{dict.vsLegacy.dentalpin.tag}</span>
      </div>
      <ul class="mt-6 space-y-3 text-[14px]">
        {dict.vsLegacy.dentalpin.bullets.map((b) => (
          <li class="flex items-start gap-3 text-[var(--color-text)]">
            <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full bg-[var(--color-primary)] text-white">
              <Icon name="check" size={12} />
            </span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </article>

    <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2 lg:block">
      <span class="flex h-12 w-12 items-center justify-center rounded-full border-[1.5px] border-[var(--color-border)] bg-[var(--color-canvas)] font-mono text-[12px] font-bold uppercase tracking-wider text-[var(--color-text-muted)] shadow-[var(--shadow-md)]">vs</span>
    </div>
  </div>

  <p class="mt-12 text-center text-[15px] italic text-[var(--color-text-muted)]">
    “{dict.vsLegacy.punchline}”
  </p>
</Section>
