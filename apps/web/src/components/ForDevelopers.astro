---
import { useDict, pagePath, type Locale } from '~/i18n';
import Section from '@dentalpin/ui/Section.astro';
import Icon from '@dentalpin/ui/Icon.astro';
import { GITHUB_REPO, DOCS_URL } from '~/config/links';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);
const f = dict.forDevelopers;
const techPath = pagePath(locale, 'technology');
---

{/*
  This was a 759px section with three cards, on a homepage whose reader is
  the clinic owner. The developer it addressed already has a whole page
  built for them — /tecnologia, in the main nav — covering architecture,
  module anatomy and the stack in far more depth than three cards could.

  So it collapses to a band: enough signal for a technical reader to know
  the depth exists, and a door to the page where it actually lives.
  Nothing is lost, and the homepage gets ~600px back.
*/}
<Section padY="sm">
  <div
    class="flex flex-col gap-5 rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-muted)]/50 px-6 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <div class="max-w-2xl">
      <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--color-primary)]">
        {f.eyebrow}
      </p>
      <p class="mt-2 text-[17px] font-semibold leading-snug text-[var(--color-text)]">
        {f.title}
      </p>
      <p class="mt-1.5 text-[14px] leading-[1.55] text-[var(--color-text-muted)]">
        {f.bandLead}
      </p>
    </div>

    <div class="flex flex-none flex-wrap items-center gap-x-5 gap-y-2 text-[14px] font-semibold">
      <a href={techPath} class="inline-flex items-center gap-1.5 text-[var(--color-primary)] hover:underline">
        {f.bandCta}
        <Icon name="arrow-right" size={13} />
      </a>
      <a
        href={GITHUB_REPO}
        target="_blank"
        rel="noopener"
        class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
      >
        GitHub
      </a>
      <a
        href={DOCS_URL}
        target="_blank"
        rel="noopener"
        class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
      >
        API
      </a>
    </div>
  </div>
</Section>
