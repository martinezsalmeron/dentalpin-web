---
// Sticky FDI odontogram indicator. Watches [data-fdi] anchors via IntersectionObserver
// and highlights the current tooth (upper right quadrant, 11..18). Decorative only.
---

<aside class="tooth-indicator" aria-hidden="true" data-tooth-indicator>
  <div class="tooth-indicator__panel">
    <p class="tooth-indicator__caption">FDI · cuad. 1</p>
    <ol class="tooth-indicator__row">
      <li data-tooth="18"><span>18</span></li>
      <li data-tooth="17"><span>17</span></li>
      <li data-tooth="16"><span>16</span></li>
      <li data-tooth="15"><span>15</span></li>
      <li data-tooth="14"><span>14</span></li>
      <li data-tooth="13"><span>13</span></li>
      <li data-tooth="12"><span>12</span></li>
      <li data-tooth="11"><span>11</span></li>
    </ol>
  </div>
</aside>

<style>
  .tooth-indicator {
    display: none;
  }
  @media (min-width: 1280px) {
    .tooth-indicator {
      display: block;
      position: fixed;
      bottom: 1.25rem;
      right: 1.25rem;
      z-index: 30;
      pointer-events: none;
    }
  }
  .tooth-indicator__panel {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(8px);
  }
  .tooth-indicator__caption {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    opacity: 0.7;
  }
  .tooth-indicator__row {
    display: flex;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tooth-indicator__row li {
    position: relative;
    width: 18px;
    height: 22px;
    border-radius: 4px 4px 7px 7px;
    border: 1px solid var(--color-border);
    background: var(--color-surface-muted);
    transition: all 220ms cubic-bezier(0.2, 0, 0.2, 1);
  }
  .tooth-indicator__row li span {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: ui-monospace, monospace;
    font-size: 8.5px;
    font-weight: 600;
    color: var(--color-text-subtle);
    opacity: 0.65;
    transition: all 220ms cubic-bezier(0.2, 0, 0.2, 1);
  }
  .tooth-indicator__row li[data-active="true"] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 10px -2px color-mix(in srgb, var(--color-primary) 50%, transparent);
  }
  .tooth-indicator__row li[data-active="true"] span {
    color: #fff;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .tooth-indicator__row li,
    .tooth-indicator__row li span {
      transition: none;
    }
    .tooth-indicator__row li[data-active="true"] {
      transform: none;
    }
  }
</style>

<script>
  const indicator = document.querySelector('[data-tooth-indicator]');
  if (indicator) {
    const teeth = indicator.querySelectorAll<HTMLElement>('[data-tooth]');
    const anchors = Array.from(document.querySelectorAll<HTMLElement>('[data-fdi]'));

    if (anchors.length > 0) {
      let current = '';
      const setActive = (fdi: string) => {
        if (fdi === current) return;
        current = fdi;
        teeth.forEach((t) => {
          t.dataset.active = t.dataset.tooth === fdi ? 'true' : 'false';
        });
      };

      const pickActive = () => {
        const trigger = window.innerHeight * 0.35;
        let active = anchors[0].dataset.fdi ?? '';
        for (const anchor of anchors) {
          const top = anchor.getBoundingClientRect().top;
          if (top <= trigger) {
            active = anchor.dataset.fdi ?? active;
          } else {
            break;
          }
        }
        setActive(active);
      };

      let ticking = false;
      const onScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            pickActive();
            ticking = false;
          });
          ticking = true;
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      window.requestAnimationFrame(pickActive);
    }
  }
</script>
