---
import { useDict, type Locale } from '~/i18n';
import Button from '@dentalpin/ui/Button.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);
const c = dict.contact;
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const field =
  'h-10 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface-sunken)] px-3 text-[14px] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)] focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] focus:outline-none';

// Order matters: the two highest-intent reasons come first, so the default
// selection is already the one most visitors want.
const reasons = ['demo', 'migration', 'install', 'dev', 'other'] as const;
---

<form
  id="contact-form"
  class="flex flex-col gap-4 rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 shadow-[var(--shadow-sm)] sm:p-8"
>
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="flex flex-col gap-1.5">
      <span class="text-ui text-[var(--color-text)]">{c.fields.name}</span>
      <input required type="text" name="name" autocomplete="name" class={field} />
    </label>
    <label class="flex flex-col gap-1.5">
      <span class="text-ui text-[var(--color-text)]">{c.fields.email}</span>
      <input required type="email" name="email" autocomplete="email" class={field} />
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="flex flex-col gap-1.5">
      <span class="text-ui text-[var(--color-text)]">{c.fields.clinic}</span>
      <input type="text" name="clinic" autocomplete="organization" class={field} />
    </label>
    {/*
      One question that routes the lead. Knowing whether this is a migration
      or an install problem before the first reply is worth more than any
      other field on the form, and it costs the visitor one click.
    */}
    <label class="flex flex-col gap-1.5">
      <span class="text-ui text-[var(--color-text)]">{c.fields.reason}</span>
      <select name="reason" class={field}>
        {reasons.map((key) => <option value={key}>{c.reasons[key]}</option>)}
      </select>
    </label>
  </div>

  <label class="flex flex-col gap-1.5">
    <span class="text-ui text-[var(--color-text)]">{c.fields.message}</span>
    <textarea
      name="message"
      rows="4"
      class="resize-y rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface-sunken)] p-3 text-[14px] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)] focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] focus:outline-none"
    ></textarea>
  </label>

  {/* Opt-in, unticked. Only a tick puts the address in the Resend audience. */}
  <label class="flex items-start gap-2.5 text-[13px] leading-snug text-[var(--color-text-muted)]">
    <input
      type="checkbox"
      name="subscribe"
      value="yes"
      class="mt-0.5 h-3.5 w-3.5 flex-none rounded-[var(--radius-xs)] border border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)]"
    />
    <span>{c.fields.subscribe}</span>
  </label>

  {/* Honeypot — spam bots fill this; real users never see it. */}
  <label class="sr-only" aria-hidden="true">
    Website
    <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </label>

  <input type="hidden" name="locale" value={locale} />

  {turnstileKey && (
    <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="light"></div>
  )}

  <div class="flex flex-wrap items-center justify-between gap-3">
    <p id="contact-status" class="text-[13px] text-[var(--color-text-muted)]" role="status" aria-live="polite"></p>
    <Button type="submit" size="md">{c.fields.submit}</Button>
  </div>

  <p class="text-[12.5px] leading-snug text-[var(--color-text-subtle)]">{c.reply}</p>
</form>

{turnstileKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script is:inline define:vars={{ successMsg: c.success, errorMsg: c.error }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('contact-status');
  if (form && status) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '…';
      status.style.color = 'var(--color-text-muted)';
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error(String(res.status));
        status.textContent = successMsg;
        status.style.color = 'var(--color-success-text)';
        form.reset();
      } catch (_) {
        status.textContent = errorMsg;
        status.style.color = 'var(--color-danger-text)';
      }
    });
  }
</script>
