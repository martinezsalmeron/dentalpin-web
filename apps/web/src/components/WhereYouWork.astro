---
import { useDict, type Locale } from '~/i18n';
import Section from '@dentalpin/ui/Section.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);
const section = dict.whereYouWork;
---

<Section id="where-you-work" padY="md">
  <div class="max-w-3xl">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
      {section.eyebrow}
    </p>
    <h2 class="text-marketing-h1 mt-3 text-[var(--color-text)]">
      {section.title}
    </h2>
    <p class="mt-4 text-[16px] leading-[1.65] text-[var(--color-text-muted)]">
      {section.lead}
    </p>
  </div>

  <div class="mt-10 inline-flex w-fit items-center gap-2 rounded-[var(--radius-pill)] border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1.5 text-[12px] font-medium text-[var(--color-text-muted)] shadow-[var(--shadow-xs)]">
    <span class="relative flex h-2 w-2">
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-primary)] opacity-60"></span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-primary)]"></span>
    </span>
    {section.syncPill}
  </div>

  <ul class="where-grid mt-6 grid gap-5 md:grid-cols-3">
    {section.scenes.map((scene, idx) => (
      <li class="group relative flex flex-col overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[var(--shadow-sm)] transition-all hover:-translate-y-0.5 hover:border-[var(--color-border-strong)] hover:shadow-[var(--shadow-md)]">
        <div class="relative aspect-[4/3] overflow-hidden border-b border-[var(--color-border-subtle)] bg-gradient-to-br from-[var(--color-surface-muted)] to-[var(--color-canvas)]">
          <div
            class="absolute inset-0 opacity-60"
            style="background-image: radial-gradient(circle, var(--color-border-strong) 1px, transparent 1px); background-size: 14px 14px;"
            aria-hidden="true"
          ></div>

          {idx === 0 && (
            <svg viewBox="0 0 320 200" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <rect x="46" y="30" width="228" height="150" rx="12" fill="var(--color-canvas)" stroke="var(--color-border-strong)" stroke-width="1.5"/>
              <rect x="58" y="42" width="204" height="126" rx="4" fill="var(--color-surface-muted)"/>
              <rect x="58" y="42" width="204" height="18" fill="var(--color-surface)"/>
              <circle cx="68" cy="51" r="3" fill="var(--color-primary)"/>
              <rect x="76" y="48" width="42" height="6" rx="3" fill="var(--color-border-strong)" opacity="0.55"/>
              <rect x="230" y="48" width="24" height="6" rx="3" fill="var(--color-border-strong)" opacity="0.4"/>
              <rect x="68" y="70" width="56" height="5" rx="2.5" fill="var(--color-text-subtle)" opacity="0.55"/>
              <g fill="var(--color-canvas)" stroke="var(--color-border-strong)" stroke-width="1">
                <rect x="68" y="84" width="22" height="28" rx="3"/>
                <rect x="92" y="84" width="22" height="28" rx="3"/>
                <rect x="140" y="84" width="22" height="28" rx="3"/>
                <rect x="164" y="84" width="22" height="28" rx="3"/>
                <rect x="188" y="84" width="22" height="28" rx="3"/>
                <rect x="236" y="84" width="22" height="28" rx="3"/>
                <rect x="68" y="116" width="22" height="28" rx="3"/>
                <rect x="92" y="116" width="22" height="28" rx="3"/>
                <rect x="140" y="116" width="22" height="28" rx="3"/>
                <rect x="164" y="116" width="22" height="28" rx="3"/>
                <rect x="188" y="116" width="22" height="28" rx="3"/>
                <rect x="236" y="116" width="22" height="28" rx="3"/>
              </g>
              <rect x="116" y="84" width="22" height="28" rx="3" fill="var(--color-primary-soft)" stroke="var(--color-primary)" stroke-width="1.5"/>
              <circle cx="127" cy="98" r="3" fill="var(--color-primary)"/>
              <rect x="212" y="116" width="22" height="28" rx="3" fill="var(--color-primary-soft)" stroke="var(--color-primary)" stroke-width="1.5"/>
              <path d="M218 130 L222 134 L230 124" stroke="var(--color-primary)" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="68" y="152" width="64" height="8" rx="4" fill="var(--color-primary)" opacity="0.85"/>
              <rect x="138" y="152" width="42" height="8" rx="4" fill="var(--color-border-strong)" opacity="0.35"/>
            </svg>
          )}

          {idx === 1 && (
            <svg viewBox="0 0 320 200" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <rect x="32" y="18" width="256" height="144" rx="6" fill="var(--color-canvas)" stroke="var(--color-border-strong)" stroke-width="1.5"/>
              <path d="M138 162 L182 162 L192 180 L128 180 Z" fill="var(--color-surface)" stroke="var(--color-border-strong)" stroke-width="1.5" stroke-linejoin="round"/>
              <rect x="116" y="180" width="88" height="4" rx="2" fill="var(--color-border-strong)" opacity="0.7"/>
              <rect x="40" y="26" width="240" height="128" rx="3" fill="var(--color-surface-muted)"/>
              <rect x="40" y="26" width="240" height="16" fill="var(--color-surface)"/>
              <circle cx="48" cy="34" r="2.5" fill="var(--color-primary)"/>
              <rect x="56" y="31.5" width="36" height="5" rx="2.5" fill="var(--color-border-strong)" opacity="0.55"/>
              <rect x="242" y="31.5" width="30" height="5" rx="2.5" fill="var(--color-border-strong)" opacity="0.4"/>
              <rect x="50" y="50" width="60" height="5" rx="2.5" fill="var(--color-text-muted)" opacity="0.6"/>
              <rect x="234" y="50" width="38" height="7" rx="3.5" fill="var(--color-primary)" opacity="0.85"/>
              <g stroke="var(--color-border)" stroke-width="0.8" opacity="0.6">
                <line x1="82" y1="66" x2="82" y2="148"/>
                <line x1="110" y1="66" x2="110" y2="148"/>
                <line x1="138" y1="66" x2="138" y2="148"/>
                <line x1="166" y1="66" x2="166" y2="148"/>
                <line x1="194" y1="66" x2="194" y2="148"/>
                <line x1="222" y1="66" x2="222" y2="148"/>
                <line x1="250" y1="66" x2="250" y2="148"/>
              </g>
              <g fill="var(--color-text-subtle)" opacity="0.6">
                <rect x="58" y="66" width="10" height="3" rx="1.5"/>
                <rect x="86" y="66" width="10" height="3" rx="1.5"/>
                <rect x="114" y="66" width="10" height="3" rx="1.5"/>
                <rect x="142" y="66" width="10" height="3" rx="1.5"/>
                <rect x="170" y="66" width="10" height="3" rx="1.5"/>
                <rect x="198" y="66" width="10" height="3" rx="1.5"/>
                <rect x="226" y="66" width="10" height="3" rx="1.5"/>
              </g>
              <rect x="56" y="78" width="22" height="14" rx="2" fill="var(--color-primary-soft)" stroke="var(--color-primary)" stroke-width="0.8"/>
              <rect x="84" y="94" width="22" height="18" rx="2" fill="var(--color-primary)" opacity="0.85"/>
              <rect x="112" y="82" width="22" height="12" rx="2" fill="var(--color-primary-soft)" stroke="var(--color-primary)" stroke-width="0.8"/>
              <rect x="140" y="102" width="22" height="24" rx="2" fill="var(--color-primary)" opacity="0.85"/>
              <rect x="168" y="78" width="22" height="16" rx="2" fill="var(--color-primary-soft)" stroke="var(--color-primary)" stroke-width="0.8"/>
              <rect x="196" y="110" width="22" height="28" rx="2" fill="var(--color-primary)" opacity="0.85"/>
              <rect x="224" y="86" width="22" height="14" rx="2" fill="var(--color-primary-soft)" stroke="var(--color-primary)" stroke-width="0.8"/>
              <rect x="252" y="104" width="22" height="18" rx="2" fill="var(--color-primary)" opacity="0.85"/>
            </svg>
          )}

          {idx === 2 && (
            <svg viewBox="0 0 320 200" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <g stroke="var(--color-primary)" fill="none" stroke-width="1" stroke-dasharray="2,3" opacity="0.45">
                <path d="M80 70 Q 80 50 100 50"/>
                <path d="M70 80 Q 70 40 110 40"/>
                <path d="M60 90 Q 60 30 120 30"/>
              </g>
              <g transform="translate(248,38)">
                <circle cx="0" cy="0" r="12" fill="var(--color-primary-soft)" stroke="var(--color-primary)" stroke-width="1.2"/>
                <path d="M0 -5 C-4 -5 -4 2 0 3 C4 2 4 -5 0 -5 Z" fill="var(--color-primary)"/>
                <circle cx="0" cy="-2" r="1.6" fill="var(--color-canvas)"/>
              </g>
              <rect x="130" y="14" width="80" height="172" rx="14" fill="var(--color-canvas)" stroke="var(--color-border-strong)" stroke-width="1.5"/>
              <rect x="155" y="22" width="30" height="3" rx="1.5" fill="var(--color-border-strong)" opacity="0.55"/>
              <rect x="136" y="32" width="68" height="146" rx="6" fill="var(--color-surface-muted)"/>
              <rect x="142" y="40" width="56" height="30" rx="4" fill="var(--color-surface)" stroke="var(--color-primary)" stroke-width="1.2"/>
              <circle cx="150" cy="50" r="3" fill="var(--color-primary)"/>
              <rect x="157" y="46" width="34" height="3" rx="1.5" fill="var(--color-text)" opacity="0.7"/>
              <rect x="157" y="52" width="26" height="2.5" rx="1.25" fill="var(--color-text-subtle)" opacity="0.7"/>
              <rect x="145" y="60" width="24" height="6" rx="3" fill="var(--color-primary)"/>
              <rect x="171" y="60" width="22" height="6" rx="3" fill="var(--color-border)"/>
              <rect x="142" y="78" width="40" height="4" rx="2" fill="var(--color-text-subtle)" opacity="0.55"/>
              <g>
                <rect x="142" y="88" width="56" height="18" rx="3" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="0.8"/>
                <circle cx="148" cy="97" r="2" fill="var(--color-primary)"/>
                <rect x="154" y="93" width="22" height="2.5" rx="1.25" fill="var(--color-text)" opacity="0.7"/>
                <rect x="154" y="99" width="30" height="2" rx="1" fill="var(--color-text-subtle)" opacity="0.6"/>
                <rect x="142" y="110" width="56" height="18" rx="3" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="0.8"/>
                <circle cx="148" cy="119" r="2" fill="var(--color-primary)"/>
                <rect x="154" y="115" width="26" height="2.5" rx="1.25" fill="var(--color-text)" opacity="0.7"/>
                <rect x="154" y="121" width="32" height="2" rx="1" fill="var(--color-text-subtle)" opacity="0.6"/>
                <rect x="142" y="132" width="56" height="18" rx="3" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="0.8"/>
                <circle cx="148" cy="141" r="2" fill="var(--color-primary)"/>
                <rect x="154" y="137" width="18" height="2.5" rx="1.25" fill="var(--color-text)" opacity="0.7"/>
                <rect x="154" y="143" width="28" height="2" rx="1" fill="var(--color-text-subtle)" opacity="0.6"/>
              </g>
              <rect x="152" y="168" width="36" height="3" rx="1.5" fill="var(--color-border-strong)" opacity="0.45"/>
            </svg>
          )}
        </div>

        <div class="flex flex-1 flex-col p-6">
          <span class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-[var(--color-text-subtle)]">
            {String(idx + 1).padStart(2, '0')} &middot; {scene.device}
          </span>
          <h3 class="mt-2 text-[18px] font-semibold leading-tight tracking-tight text-[var(--color-text)]">
            {scene.title}
          </h3>
          <p class="mt-3 text-[14.5px] leading-[1.6] text-[var(--color-text-muted)]">
            {scene.body}
          </p>
        </div>
      </li>
    ))}
  </ul>
</Section>

<style>
  @media (min-width: 768px) {
    .where-grid > li + li::before {
      content: '';
      position: absolute;
      left: -14px;
      top: 28%;
      width: 14px;
      height: 2px;
      background-image: linear-gradient(to right, var(--color-border-strong) 50%, transparent 50%);
      background-size: 6px 2px;
      background-repeat: repeat-x;
      opacity: 0.7;
      pointer-events: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-ping { animation: none !important; }
  }
</style>
