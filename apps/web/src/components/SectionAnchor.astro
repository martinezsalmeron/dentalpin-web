---
interface Props { fdi: string; label?: string; }
const { fdi, label } = Astro.props;
---

<div class="dental-anchor" data-fdi={fdi} data-fdi-label={label ?? ''} aria-hidden="true">
  <span class="dental-anchor__num">{fdi}</span>
</div>

<style>
  .dental-anchor {
    position: relative;
    height: 0;
    scroll-margin-top: 6rem;
  }
  .dental-anchor__num {
    display: none;
  }
  @media (min-width: 1280px) {
    .dental-anchor__num {
      display: block;
      position: absolute;
      left: max(1rem, calc(50% - 38rem));
      top: 1.75rem;
      font-family: ui-monospace, monospace;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.18em;
      color: var(--color-text-subtle);
      opacity: 0.55;
      pointer-events: none;
    }
  }
</style>
