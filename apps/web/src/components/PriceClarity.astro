---
import { useDict, pagePath, type Locale } from '~/i18n';
import Section from '@dentalpin/ui/Section.astro';
import Icon from '@dentalpin/ui/Icon.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);
const pricingHref = pagePath(locale, 'pricing');
---

<Section id="price" padY="md">
  <div class="relative overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface-muted)] p-8 sm:p-12 lg:p-16">
    <!-- Decorative big "0 €" sits behind the headline -->
    <span
      aria-hidden="true"
      class="pointer-events-none absolute right-4 top-2 select-none font-mono text-[clamp(8rem,18vw,17rem)] font-black leading-none text-[var(--color-primary)] opacity-[0.06] sm:right-10"
    >0€</span>

    <div class="relative">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
        {dict.priceClarity.eyebrow}
      </p>
      <h2 class="mt-3 max-w-3xl text-[clamp(2rem,2.4vw+1rem,3.5rem)] font-bold leading-[1.05] tracking-[-0.02em] text-[var(--color-text)]">
        {dict.priceClarity.title}
      </h2>
      <p class="mt-5 max-w-2xl text-[16px] leading-[1.65] text-[var(--color-text-muted)]">
        {dict.priceClarity.lead}
      </p>

      <ul class="mt-10 grid gap-4 sm:grid-cols-3">
        {dict.priceClarity.claims.map((claim) => (
          <li class="flex items-start gap-3 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
            <span class="mt-0.5 inline-flex h-7 w-7 flex-none items-center justify-center rounded-full bg-[var(--color-primary)] text-white" style="color:#fff">
              <Icon name="check" size={14} />
            </span>
            <span class="text-[14.5px] leading-[1.55] text-[var(--color-text)]">
              {claim}
            </span>
          </li>
        ))}
      </ul>

      <p class="mt-10 text-[13px] leading-[1.65] text-[var(--color-text-muted)]">
        {dict.priceClarity.footnote}{' '}
        <a
          href={pricingHref}
          class="font-semibold text-[var(--color-primary)] underline decoration-dotted underline-offset-4 hover:text-[var(--color-primary-hover)]"
        >
          {dict.priceClarity.footnoteCta}
        </a>
      </p>
    </div>
  </div>
</Section>
