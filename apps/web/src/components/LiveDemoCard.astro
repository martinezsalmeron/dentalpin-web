---
import { useDict, type Locale } from '~/i18n';
import Section from '@dentalpin/ui/Section.astro';
import Button from '@dentalpin/ui/Button.astro';
import Icon from '@dentalpin/ui/Icon.astro';
import GradientBackdrop from '@dentalpin/ui/GradientBackdrop.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);
const demoUrl = 'https://demo.dentalpin.com';
---

<Section id="demo" padY="md">
  <div class="relative overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 shadow-[var(--shadow-md)] sm:p-12">
    <GradientBackdrop variant="subtle" />

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,380px)] lg:items-center">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
          {dict.demo.eyebrow}
        </p>
        <h2 class="text-marketing-h1 mt-3 text-[var(--color-text)]">
          {dict.demo.title}
        </h2>
        <p class="mt-4 max-w-[55ch] text-[15px] text-[var(--color-text-muted)]">
          {dict.demo.body}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <Button href={demoUrl} size="lg" variant="solid">
            {dict.demo.cta}
            <Icon name="arrow-right" size={16} />
          </Button>
          <a href={demoUrl} class="font-mono text-[13px] text-[var(--color-text-muted)] underline decoration-dotted underline-offset-4 hover:text-[var(--color-primary)]">
            {dict.demo.url}
          </a>
        </div>
      </div>

      <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface-muted)] p-5">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
          {dict.demo.credentials.label}
        </p>
        <dl class="mt-3 space-y-2 font-mono text-[12.5px]">
          <div class="flex items-center justify-between gap-4">
            <dt class="text-[var(--color-text-subtle)]">admin</dt>
            <dd class="truncate text-[var(--color-text)]">{dict.demo.credentials.admin}</dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-[var(--color-text-subtle)]">password</dt>
            <dd class="truncate text-[var(--color-text)]">{dict.demo.credentials.password}</dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-[var(--color-text-subtle)]">others</dt>
            <dd class="text-[var(--color-text-muted)]">{dict.demo.credentials.others}</dd>
          </div>
        </dl>
        <p class="mt-4 text-[12px] text-[var(--color-warning-text)]">
          ⓘ {dict.demo.disclaimer}
        </p>
      </div>
    </div>
  </div>
</Section>
