---
import { useDict, type Locale } from '~/i18n';
import GradientBackdrop from '@dentalpin/ui/GradientBackdrop.astro';
import Button from '@dentalpin/ui/Button.astro';
import Icon from '@dentalpin/ui/Icon.astro';
import ScreenshotPlaceholder from './ScreenshotPlaceholder.astro';
import { DEMO_URL, GITHUB_REPO } from '~/config/links';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);

const demoUrl = DEMO_URL;
const ghUrl = GITHUB_REPO;
---

<section class="relative overflow-hidden">
  <GradientBackdrop variant="hero" />

  <div class="mx-auto flex max-w-6xl flex-col items-center px-6 pt-20 pb-12 text-center sm:px-8 sm:pt-28">
    <span class="inline-flex items-center gap-1.5 rounded-[var(--radius-pill)] border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--color-primary)] backdrop-blur">
      <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]"></span>
      {dict.hero.eyebrow}
    </span>

    <h1 class="text-marketing-hero mt-6 max-w-5xl text-[var(--color-text)]">
      {dict.hero.titleBefore}<span class="font-extrabold">{dict.hero.titleHighlight}</span>{dict.hero.titleAfter}{' '}
      <span class="bg-gradient-to-r from-[var(--color-primary)] via-[#22d3ee] to-[#a78bfa] bg-clip-text text-transparent">
        {dict.hero.titleAccent}
      </span>
    </h1>

    <p class="mt-6 max-w-2xl text-[17px] leading-[1.55] text-[var(--color-text-muted)]">
      {dict.hero.subtitle}
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href={demoUrl} size="lg">
        {dict.hero.ctaPrimary}
        <Icon name="arrow-right" size={16} />
      </Button>
      <Button href={ghUrl} variant="outline" size="lg">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.52 2.87 8.36 6.85 9.71.5.1.68-.22.68-.48v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.57 2.34 1.12 2.91.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.04A9.42 9.42 0 0 1 12 7.1c.85 0 1.7.12 2.5.34 1.9-1.32 2.74-1.04 2.74-1.04.55 1.4.2 2.44.1 2.7.64.71 1.03 1.62 1.03 2.74 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9v2.81c0 .26.18.59.69.48A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2z" />
        </svg>
        {dict.hero.ctaSecondary}
      </Button>
    </div>

    <p class="mt-8 text-[12px] uppercase tracking-wider text-[var(--color-text-subtle)]">
      {dict.hero.trust}
    </p>
  </div>

  <!-- Product screenshot — placeholder until user provides home.png -->
  <div class="relative mx-auto max-w-6xl px-6 pb-4 sm:px-8">
    <ScreenshotPlaceholder file="home.png" alt="Dentalpin dashboard" aspect="16 / 10" />
  </div>
</section>
