---
import { localised, useDict, localisedPath, pagePath, type Locale } from '~/i18n';
import Button from '@dentalpin/ui/Button.astro';
import Icon from '@dentalpin/ui/Icon.astro';
import LanguagePicker from './LanguagePicker.astro';
import MegaMenuFeatures from './MegaMenuFeatures.astro';
import { DEMO_URL, GITHUB_REPO, TELEGRAM_URL } from '~/config/links';
import { getGithubStars, formatStars } from '~/lib/github-stars';
import { modulesByDomain, moduleSlug, type ModuleDomain } from '~/data/modules';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = useDict(locale);

const demoUrl = DEMO_URL;
const githubUrl = GITHUB_REPO;

const stars = await getGithubStars('martinezsalmeron', 'dentalpin');

const mobileDomains: { key: ModuleDomain; label: string }[] = [
  { key: 'clinical', label: dict.megamenu.columns.clinical },
  { key: 'operations', label: dict.megamenu.columns.operations },
  { key: 'platform', label: dict.megamenu.columns.platform },
];
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border-subtle)] bg-[color-mix(in_oklab,var(--color-canvas)_88%,transparent)] backdrop-blur">
  <nav class="mx-auto flex h-14 max-w-7xl items-center gap-4 px-6 sm:px-8" aria-label={dict.nav.ariaMain}>
    <a href={localisedPath(locale)} class="flex flex-none items-center gap-2 font-semibold">
      <span aria-hidden="true" style="color:#fff" class="inline-flex h-7 w-7 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--color-primary)] text-white">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 3c-2.5 0-4 2-4 5 0 2 .8 3 1.2 5 .3 1.5.2 3 .6 5 .3 1.5 1 3 2.2 3 1.5 0 1.5-3 2-4.5.3-.9.7-1 1-1s.7.1 1 1c.5 1.5.5 4.5 2 4.5 1.2 0 1.9-1.5 2.2-3 .4-2 .3-3.5.6-5 .4-2 1.2-3 1.2-5 0-3-1.5-5-4-5-1.3 0-2 .7-3 .7s-1.7-.7-3-.7z" />
        </svg>
      </span>
      <span class="text-[15px] tracking-tight">Dentalpin</span>
    </a>

    <ul class="hidden flex-1 items-center gap-1 lg:flex">
      <li><MegaMenuFeatures locale={locale} /></li>
      <li>
        <a class="rounded-[var(--radius-sm)] px-3 py-2 text-[14px] text-[var(--color-text-muted)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)]" href={pagePath(locale, 'technology')}>
          {dict.nav.technology}
        </a>
      </li>
      <li>
        <a class="rounded-[var(--radius-sm)] px-3 py-2 text-[14px] text-[var(--color-text-muted)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)]" href={pagePath(locale, 'pricing')}>
          {dict.nav.pricing}
        </a>
      </li>
      <li>
        <a class="rounded-[var(--radius-sm)] px-3 py-2 text-[14px] text-[var(--color-text-muted)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)]" href={pagePath(locale, 'manifesto')}>
          {dict.nav.manifesto}
        </a>
      </li>
      <li>
        <a class="rounded-[var(--radius-sm)] px-3 py-2 text-[14px] text-[var(--color-text-muted)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)]" href={pagePath(locale, 'blog')}>
          {dict.nav.blog}
        </a>
      </li>
      <li>
        <a class="rounded-[var(--radius-sm)] px-3 py-2 text-[14px] text-[var(--color-text-muted)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)]" href={pagePath(locale, 'contact')}>
          {dict.nav.contact}
        </a>
      </li>
    </ul>

    <div class="ml-auto flex items-center gap-2">
      <LanguagePicker locale={locale} />
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener"
        class="hidden h-9 items-center gap-1.5 rounded-[var(--radius-sm)] px-3 text-[13px] font-medium text-[var(--color-text-muted)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)] md:inline-flex"
        aria-label="GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.52 2.87 8.36 6.85 9.71.5.1.68-.22.68-.48v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.57 2.34 1.12 2.91.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.04A9.42 9.42 0 0 1 12 7.1c.85 0 1.7.12 2.5.34 1.9-1.32 2.74-1.04 2.74-1.04.55 1.4.2 2.44.1 2.7.64.71 1.03 1.62 1.03 2.74 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9v2.81c0 .26.18.59.69.48A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2z" />
        </svg>
        <span class="flex items-center gap-1">
          <span>Star</span>
          <span
            data-gh-stars
            data-gh-repo="martinezsalmeron/dentalpin"
            class={`items-center gap-0.5 rounded-[var(--radius-xs)] bg-[var(--color-surface-sunken)] px-1.5 py-0.5 font-mono text-[11px] tabular-nums text-[var(--color-text)] ${stars !== null ? 'flex' : 'hidden'}`}
          >
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="text-[var(--color-warning-accent)]">
              <path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
            </svg>
            <span data-gh-stars-count>{stars !== null ? formatStars(stars) : ''}</span>
          </span>
        </span>
      </a>
      <div class="hidden lg:block">
        <Button href={demoUrl} size="sm">
          <Icon name="arrow-right" size={14} />
          {dict.nav.liveDemo}
        </Button>
      </div>

      <details class="mobile-nav static lg:hidden" data-mobile-nav>
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-[var(--radius-sm)] text-[var(--color-text-muted)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)]"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={dict.nav.openMenu}
        >
          <svg class="mobile-nav-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="20" y2="17" />
          </svg>
          <svg class="mobile-nav-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18" />
            <line x1="6" y1="18" x2="18" y2="6" />
          </svg>
        </summary>

        <div class="mobile-nav-panel absolute left-0 right-0 top-full max-h-[calc(100vh-3.5rem)] overflow-y-auto overscroll-contain border-t border-[var(--color-border)] bg-[var(--color-canvas)] shadow-[var(--shadow-lg)]" role="menu">
          <ul class="mx-auto flex max-w-7xl flex-col gap-1 px-6 py-3 sm:px-8">
            <li>
              <details class="mobile-nav-sub group/sub">
                <summary class="flex cursor-pointer list-none items-center justify-between rounded-[var(--radius-sm)] px-3 py-2.5 text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-surface-muted)]">
                  <span>{dict.nav.features}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open/sub:rotate-180" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </summary>
                <div class="mt-1 flex flex-col gap-4 rounded-[var(--radius-md)] bg-[var(--color-surface-muted)] px-3 py-3">
                  {mobileDomains.map((domain) => (
                    <div>
                      <p class="mb-1.5 px-2 text-[11px] font-semibold uppercase tracking-wider text-[var(--color-text-subtle)]">
                        {domain.label}
                      </p>
                      <ul class="flex flex-col">
                        {modulesByDomain(domain.key).map((mod) => (
                          <li>
                            <a
                              href={pagePath(locale, 'features', moduleSlug(mod, locale))}
                              class="flex items-start gap-2.5 rounded-[var(--radius-sm)] px-2 py-2 text-[14px] text-[var(--color-text)] hover:bg-[var(--color-surface)]"
                            >
                              <span class="mt-0.5 inline-flex h-6 w-6 flex-none items-center justify-center rounded-[var(--radius-sm)] bg-[var(--color-primary-soft)] text-[var(--color-primary-soft-text)]">
                                <Icon name={mod.icon} size={14} />
                              </span>
                              <span class="font-medium">{localised(mod.title, locale)}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                  <a
                    href={pagePath(locale, 'features')}
                    class="mt-1 inline-flex items-center gap-1 px-2 text-[13px] font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-hover)]"
                  >
                    {dict.megamenu.footer}
                  </a>
                </div>
              </details>
            </li>
            <li>
              <a class="block rounded-[var(--radius-sm)] px-3 py-2.5 text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-surface-muted)]" href={pagePath(locale, 'technology')}>
                {dict.nav.technology}
              </a>
            </li>
            <li>
              <a class="block rounded-[var(--radius-sm)] px-3 py-2.5 text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-surface-muted)]" href={pagePath(locale, 'pricing')}>
                {dict.nav.pricing}
              </a>
            </li>
            <li>
              <a class="block rounded-[var(--radius-sm)] px-3 py-2.5 text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-surface-muted)]" href={pagePath(locale, 'manifesto')}>
                {dict.nav.manifesto}
              </a>
            </li>
            <li>
              <a class="block rounded-[var(--radius-sm)] px-3 py-2.5 text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-surface-muted)]" href={pagePath(locale, 'blog')}>
                {dict.nav.blog}
              </a>
            </li>
            <li>
              <a class="block rounded-[var(--radius-sm)] px-3 py-2.5 text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-surface-muted)]" href={pagePath(locale, 'contact')}>
                {dict.nav.contact}
              </a>
            </li>
            {/* The two off-site doors, which the mobile menu had no room for before. */}
            <li class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-[var(--color-border-subtle)] px-3 pt-3 text-[14px] font-medium">
              <a class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]" href={githubUrl} target="_blank" rel="noopener">GitHub</a>
              <a class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]" href={TELEGRAM_URL} target="_blank" rel="noopener">Telegram</a>
            </li>
            <li class="mt-3">
              <a class="inline-flex items-center gap-2 rounded-[var(--radius-sm)] bg-[var(--color-primary)] px-4 py-2.5 text-[14px] font-semibold text-white shadow-[var(--shadow-xs)] hover:bg-[var(--color-primary-hover)]" style="color:#fff" href={demoUrl}>
                <Icon name="arrow-right" size={14} />
                {dict.nav.liveDemo}
              </a>
            </li>
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  details.mobile-nav > summary::-webkit-details-marker { display: none; }
  details.mobile-nav > summary { list-style: none; }
  details.mobile-nav:not([open]) .mobile-nav-panel { display: none; }
  details.mobile-nav:not([open]) .mobile-nav-icon-close { display: none; }
  details.mobile-nav[open] .mobile-nav-icon-open { display: none; }
  details.mobile-nav-sub > summary::-webkit-details-marker { display: none; }
  details.mobile-nav-sub > summary { list-style: none; }
  body:has(details[data-mobile-nav][open]) { overflow: hidden; }
</style>

<script is:inline>
  (() => {
    const details = document.querySelectorAll('details[data-mobile-nav]');
    if (!details.length) return;
    const mql = window.matchMedia('(min-width: 1024px)');
    const closeAll = () => {
      details.forEach((el) => {
        el.removeAttribute('open');
        el.querySelector('summary')?.setAttribute('aria-expanded', 'false');
      });
    };
    details.forEach((el) => {
      el.addEventListener('toggle', () => {
        el.querySelector('summary')?.setAttribute('aria-expanded', el.hasAttribute('open') ? 'true' : 'false');
      });
    });
    document.addEventListener('click', (e) => {
      details.forEach((el) => {
        if (el.hasAttribute('open') && !el.contains(e.target)) {
          el.removeAttribute('open');
          el.querySelector('summary')?.setAttribute('aria-expanded', 'false');
        }
      });
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
    mql.addEventListener('change', (e) => { if (e.matches) closeAll(); });
  })();
</script>

<script is:inline>
  (function () {
    var badge = document.querySelector('[data-gh-stars]');
    if (!badge) return;
    var target = badge.querySelector('[data-gh-stars-count]');
    if (!target) return;
    var repo = badge.getAttribute('data-gh-repo') || 'martinezsalmeron/dentalpin';
    var key = 'gh-stars:' + repo;
    var TTL = 5 * 60 * 1000;

    function format(n) {
      if (n < 1000) return String(n);
      if (n < 10000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
      return Math.round(n / 1000) + 'k';
    }
    function show(n) {
      if (typeof n !== 'number') return;
      target.textContent = format(n);
      badge.classList.remove('hidden');
      badge.classList.add('flex');
    }

    try {
      var raw = localStorage.getItem(key);
      if (raw) {
        var cached = JSON.parse(raw);
        if (cached && typeof cached.count === 'number' && Date.now() - cached.ts < TTL) {
          show(cached.count);
        }
      }
    } catch (_) {}

    fetch('https://api.github.com/repos/' + repo, {
      headers: { Accept: 'application/vnd.github+json' },
    })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d || typeof d.stargazers_count !== 'number') return;
        show(d.stargazers_count);
        try {
          localStorage.setItem(key, JSON.stringify({ count: d.stargazers_count, ts: Date.now() }));
        } catch (_) {}
      })
      .catch(function () {});
  })();
</script>
