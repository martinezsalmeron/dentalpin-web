---
import { useDict, localisedPath, type Locale } from '~/i18n';
import { moduleBySlug } from '~/data/modules';
import Section from '@dentalpin/ui/Section.astro';
import Icon from '@dentalpin/ui/Icon.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);

// Six flagship modules for the bento, in an asymmetric layout.
// Feature card = odontograma (8 cols), flanked by smaller ones.
const FEATURED = [
  { slug: 'odontograma', colClass: 'lg:col-span-8 lg:row-span-2', featured: true },
  { slug: 'agenda', colClass: 'lg:col-span-4' },
  { slug: 'plan-tratamiento', colClass: 'lg:col-span-4' },
  { slug: 'presupuestos', colClass: 'lg:col-span-4' },
  { slug: 'pacientes', colClass: 'lg:col-span-4' },
  { slug: 'reportes', colClass: 'lg:col-span-4' },
].map((item) => ({ ...item, mod: moduleBySlug(item.slug)! }));

const ctaLabel = locale === 'es' ? 'Ver módulo' : 'Open module';
---

<Section id="features" padY="md">
  <div class="max-w-2xl">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
      {dict.bento.eyebrow}
    </p>
    <h2 class="text-marketing-h1 mt-3 text-[var(--color-text)]">
      {dict.bento.title}
    </h2>
    <p class="mt-4 text-[15px] text-[var(--color-text-muted)]">
      {dict.bento.subtitle}
    </p>
  </div>

  <ul class="mt-10 grid auto-rows-[minmax(0,1fr)] grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-12">
    {FEATURED.map(({ mod, colClass, featured }) => (
      <li class:list={[
        colClass,
        'group relative overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[var(--shadow-sm)] transition-all hover:-translate-y-0.5 hover:border-[var(--color-border-strong)] hover:shadow-[var(--shadow-md)]',
      ]}>
        <a
          href={localisedPath(locale, `features/${mod.slug}`)}
          class="flex h-full flex-col p-6 focus-visible:outline-none lg:p-7"
        >
          <div class="flex items-start justify-between">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-[var(--radius-md)] bg-gradient-to-br from-[var(--color-primary-soft)] to-[var(--color-surface-muted)] text-[var(--color-primary-soft-text)] ring-1 ring-[var(--color-border-subtle)]">
              <Icon name={mod.icon} size={20} />
            </span>
            <span class="inline-flex items-center gap-1 text-[12px] font-semibold text-[var(--color-primary)] opacity-0 transition-opacity group-hover:opacity-100">
              {ctaLabel}
              <Icon name="arrow-right" size={12} />
            </span>
          </div>

          <h3 class:list={[
            'mt-5 tracking-tight text-[var(--color-text)]',
            featured ? 'text-[24px] font-semibold leading-tight' : 'text-[17px] font-semibold',
          ]}>
            {mod.title[locale]}
          </h3>
          <p class:list={[
            'mt-2 max-w-prose leading-[1.55] text-[var(--color-text-muted)]',
            featured ? 'text-[15px]' : 'text-[14px]',
          ]}>
            {mod.tagline[locale]}
          </p>

          {featured && (
            <figure class="mt-6 flex-1 overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-muted)] shadow-[var(--shadow-sm)]">
              <img
                src="/screenshots/dental-chart.png"
                alt={mod.title[locale]}
                loading="lazy"
                decoding="async"
                class="block h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.015]"
              />
            </figure>
          )}
        </a>
      </li>
    ))}
  </ul>
</Section>
