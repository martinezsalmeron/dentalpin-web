---
import { useDict, type Locale } from '~/i18n';
import Section from '@dentalpin/ui/Section.astro';
import Badge from '@dentalpin/ui/Badge.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dict = useDict(locale);
---

<Section id="roadmap" padY="md">
  <div class="max-w-2xl">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-[var(--color-primary)]">
      {dict.roadmap.eyebrow}
    </p>
    <h2 class="text-marketing-h1 mt-3 text-[var(--color-text)]">
      {dict.roadmap.title}
    </h2>
  </div>

  <ul class="mt-10 grid gap-4 md:grid-cols-3">
    {dict.roadmap.items.map((item) => (
      <li class="rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 shadow-[var(--shadow-sm)]">
        <Badge role="warning">{locale === 'es' ? 'Próximamente' : 'Coming soon'}</Badge>
        <h3 class="mt-4 text-[17px] font-semibold tracking-tight text-[var(--color-text)]">
          {item.title}
        </h3>
        <p class="mt-2 text-[14px] leading-[1.6] text-[var(--color-text-muted)]">
          {item.body}
        </p>
      </li>
    ))}
  </ul>
</Section>
