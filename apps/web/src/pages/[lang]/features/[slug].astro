---
import { isLocale, useDict, localisedPath, type Locale } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '@dentalpin/ui/Section.astro';
import Button from '@dentalpin/ui/Button.astro';
import Icon from '@dentalpin/ui/Icon.astro';
import ScreenshotPlaceholder from '~/components/ScreenshotPlaceholder.astro';
import CTASection from '~/components/CTASection.astro';
import { MODULES, moduleBySlug } from '~/data/modules';

export function getStaticPaths() {
  return (['es', 'en'] as const).flatMap((lang) =>
    MODULES.map((m) => ({
      params: { lang, slug: m.slug },
    })),
  );
}

const { lang, slug } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/es/', 308);
const locale = lang as Locale;
const dict = useDict(locale);
const mod = moduleBySlug(slug!);
if (!mod) return Astro.redirect(localisedPath(locale, 'funcionalidades'), 308);

import { DEMO_URL, GITHUB_REPO } from '~/config/links';

const demoUrl = DEMO_URL;
const ghUrl = GITHUB_REPO;
---

<BaseLayout locale={locale} title={`${mod.title[locale]} · Dentalpin`}>
  <Section padY="md">
    <a
      href={localisedPath(locale, 'funcionalidades')}
      class="inline-flex items-center gap-1 text-[13px] font-medium text-[var(--color-text-muted)] hover:text-[var(--color-primary)]"
    >
      {dict.featurePage.backToIndex}
    </a>
  </Section>

  <Section padY="sm">
    <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-primary-soft)] text-[var(--color-primary-soft-text)]">
            <Icon name={mod.icon} size={22} />
          </span>
          {mod.status === 'roadmap' && (
            <span class="inline-flex rounded-[var(--radius-pill)] bg-[var(--color-warning-soft)] px-2.5 py-0.5 text-[11px] font-medium text-[var(--color-warning-text)]">
              {dict.featurePage.statusRoadmap}
            </span>
          )}
        </div>
        <h1 class="text-marketing-h1 mt-5 text-[var(--color-text)]">
          {mod.title[locale]}
        </h1>
        <p class="mt-4 text-[17px] leading-[1.55] text-[var(--color-text-muted)]">
          {mod.description[locale]}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <Button href={demoUrl} size="md">{dict.featurePage.ctaDemo}</Button>
          <Button href={ghUrl} variant="outline" size="md">{dict.featurePage.ctaGithub}</Button>
        </div>
      </div>
    </div>
  </Section>

  <Section padY="md">
    <ScreenshotPlaceholder file={mod.screenshot} alt={mod.title[locale]} />
  </Section>

  {mod.extraScreenshots && mod.extraScreenshots.length > 0 && (
    <Section padY="sm">
      <ul class="grid gap-6 md:grid-cols-2">
        {mod.extraScreenshots.map((extra) => (
          <li>
            <ScreenshotPlaceholder file={extra.file} alt={extra.caption[locale]} />
            <p class="mt-3 text-[13px] text-[var(--color-text-muted)]">
              {extra.caption[locale]}
            </p>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <Section padY="md">
    <h2 class="text-[13px] font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
      {dict.featurePage.capabilities}
    </h2>
    <ul class="mt-6 grid gap-3 md:grid-cols-2">
      {mod.features.map((f) => (
        <li class="flex items-start gap-3 rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface)] p-4">
          <span class="mt-0.5 inline-flex h-5 w-5 flex-none items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[var(--color-primary-soft-text)]">
            <Icon name="check" size={12} />
          </span>
          <span class="text-[14px] leading-[1.55] text-[var(--color-text)]">
            {f[locale]}
          </span>
        </li>
      ))}
    </ul>
  </Section>

  <CTASection locale={locale} />
</BaseLayout>
