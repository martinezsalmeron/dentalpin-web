---
import { isLocale, type Locale } from '~/i18n';
import ContactBody from '~/components/pages/ContactBody.astro';

export function getStaticPaths() {
  // FR shares the English slug, so it hangs off this file rather than its own.
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/es/', 308);
const locale = lang as Locale;
---

<ContactBody locale={locale} />
