---
import { getCollection } from 'astro:content';
import { DATE_LOCALE, isLocale, useTranslations, type Locale } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '@dentalpin/ui/Section.astro';
import { localeOf, slugOf, postPath, isPublished } from '~/lib/blog';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/es/', 308);
const locale = lang as Locale;
const t = useTranslations(locale);

const posts = (await getCollection('blog'))
  .filter((p) => localeOf(p.id) === locale && isPublished(p))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const dateFmt = new Intl.DateTimeFormat(DATE_LOCALE[locale], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  locale={locale}
  title={`${t('blog.title')} · Dentalpin`}
  description={t('blog.subtitle')}
>
  <Section maxWidth="narrow" padY="lg">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-marketing-h1 text-[var(--color-text)]">{t('blog.title')}</h1>
        <p class="mt-3 text-[var(--color-text-muted)]">{t('blog.subtitle')}</p>
      </div>
      <a
        href={`/${locale}/rss.xml`}
        class="text-sm underline underline-offset-4 text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
      >
        {t('blog.rss')}
      </a>
    </header>

    {posts.length === 0 ? (
      <p class="mt-16 text-[var(--color-text-muted)]">{t('blog.empty')}</p>
    ) : (
      <ul class="mt-16 space-y-12">
        {posts.map((post) => (
          <li>
            <article>
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-sm text-[var(--color-text-muted)]"
              >
                {dateFmt.format(post.data.pubDate)}
              </time>
              <h2 class="mt-2 text-marketing-h3 text-[var(--color-text)]">
                <a
                  href={postPath(locale, slugOf(post.id))}
                  class="underline-offset-4 hover:underline"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 text-[var(--color-text-muted)]">{post.data.description}</p>
            </article>
          </li>
        ))}
      </ul>
    )}
  </Section>
</BaseLayout>
