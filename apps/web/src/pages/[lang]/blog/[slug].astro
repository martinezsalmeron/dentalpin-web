---
import { getCollection, render } from 'astro:content';
import {
  DATE_LOCALE,
  HTML_LANG,
  LOCALES,
  isLocale,
  useTranslations,
  pagePath,
  type Locale,
} from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '@dentalpin/ui/Section.astro';
import Button from '@dentalpin/ui/Button.astro';
import { DEMO_URL } from '~/config/links';
import { slugOf, isPublished, readingMinutes, postsForLocale } from '~/lib/blog';
import '~/styles/post.css';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(isPublished);
  // A regional variant serves its parent's posts under its own prefix, so the
  // path list is built per locale rather than per post.
  return LOCALES.flatMap((lang) =>
    postsForLocale(posts, lang).map((post) => ({
      params: { lang, slug: slugOf(post.id) },
      props: { post },
    }))
  );
}

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/es/', 308);
const locale = lang as Locale;
const t = useTranslations(locale);

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Only h2s — an index that mirrors every h3 stops being an index.
const toc = headings.filter((h) => h.depth === 2);
const minutes = readingMinutes(post.body ?? '');

const dateFmt = new Intl.DateTimeFormat(DATE_LOCALE[locale], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.dentalpin.com';
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: HTML_LANG[locale],
  mainEntityOfPage: `${site}/${locale}/blog/${Astro.params.slug}/`,
  author: { '@type': 'Organization', name: 'Dentalpin', url: site },
  publisher: { '@type': 'Organization', name: 'Dentalpin', url: site },
};
---

<BaseLayout
  locale={locale}
  title={`${post.data.title} · Dentalpin`}
  description={post.data.description}
  ogImage={post.data.ogImage}
>
  <article>
    <!-- Hero -->
    <Section maxWidth="default" padY="md">
      <div class="mx-auto max-w-3xl">
        <a
          href={`/${locale}/blog/`}
          class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]"
        >
          <span aria-hidden="true">←</span>
          {t('blog.backToBlog')}
        </a>

        <h1
          class="mt-6 text-[length:var(--text-marketing-h1)] font-semibold leading-[1.1] tracking-[-0.025em] text-[var(--color-text)]"
        >
          {post.data.title}
        </h1>

        <p class="mt-5 text-lg leading-relaxed text-[var(--color-text-muted)]">
          {post.data.description}
        </p>

        <div
          class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-[var(--color-border-subtle)] pt-5 text-sm text-[var(--color-text-subtle)]"
        >
          <time datetime={post.data.pubDate.toISOString()}>
            {dateFmt.format(post.data.pubDate)}
          </time>
          <span aria-hidden="true">·</span>
          <span>{minutes} {t('blog.minRead')}</span>
          {post.data.updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                {t('blog.updatedOn')}{' '}
                <time datetime={post.data.updatedDate.toISOString()}>
                  {dateFmt.format(post.data.updatedDate)}
                </time>
              </span>
            </>
          )}
          {post.data.tags.length > 0 && (
            <ul class="flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <li
                  class="rounded-[var(--radius-xs)] bg-[var(--color-surface-muted)] px-2 py-0.5 text-[12px] font-medium text-[var(--color-text-muted)]"
                >
                  {tag}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </Section>

    <!-- Body + table of contents -->
    <Section maxWidth="wide" padY="sm">
      <div class="lg:grid lg:grid-cols-[1fr_15rem] lg:items-start lg:gap-12">
        <div class="post min-w-0">
          <Content />
        </div>

        {toc.length > 2 && (
          <nav
            aria-label={t('blog.onThisPage')}
            class="order-first mb-10 lg:sticky lg:top-24 lg:order-none lg:mb-0"
          >
            <p
              class="mb-3 text-[11px] font-semibold uppercase tracking-wider text-[var(--color-text-subtle)]"
            >
              {t('blog.onThisPage')}
            </p>
            <ul class="flex flex-col gap-2 border-l border-[var(--color-border-subtle)]">
              {toc.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="-ml-px block border-l border-transparent pl-3 text-[13px] leading-snug text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-text)]"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </Section>

    <!-- Closing CTA -->
    <Section maxWidth="default" padY="lg">
      <div
        class="mx-auto flex max-w-3xl flex-col gap-5 rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface)] p-7 sm:flex-row sm:items-center sm:justify-between sm:p-8"
      >
        <div>
          <p class="text-lg font-semibold text-[var(--color-text)]">
            {t('blog.ctaTitle')}
          </p>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-text-muted)]">
            {t('blog.ctaBody')}
          </p>
        </div>
        <div class="flex flex-none flex-wrap gap-2.5">
          <Button href={DEMO_URL} size="sm">{t('blog.ctaDemo')}</Button>
          <Button href={pagePath(locale, 'pricing')} size="sm" variant="outline">
            {t('blog.ctaPricing')}
          </Button>
        </div>
      </div>
    </Section>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
</BaseLayout>
