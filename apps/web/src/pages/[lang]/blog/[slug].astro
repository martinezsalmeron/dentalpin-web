---
import { getCollection, render } from 'astro:content';
import { isLocale, useTranslations, type Locale } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '@dentalpin/ui/Section.astro';
import { localeOf, slugOf, isPublished } from '~/lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter(isPublished).map((post) => ({
    params: { lang: localeOf(post.id), slug: slugOf(post.id) },
    props: { post },
  }));
}

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/es/', 308);
const locale = lang as Locale;
const t = useTranslations(locale);

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// BaseLayout emits SoftwareApplication for the site as a whole; a post
// is an Article. Both on one page is valid, and the dates here are what
// earn the timestamp Google shows beside the result.
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.dentalpin.com';
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: locale === 'es' ? 'es-ES' : 'en-US',
  mainEntityOfPage: `${site}/${locale}/blog/${Astro.params.slug}/`,
  author: { '@type': 'Organization', name: 'Dentalpin', url: site },
  publisher: { '@type': 'Organization', name: 'Dentalpin', url: site },
};
---

<BaseLayout
  locale={locale}
  title={`${post.data.title} · Dentalpin`}
  description={post.data.description}
  ogImage={post.data.ogImage}
>
  <Section maxWidth="narrow" padY="lg">
    <a
      href={`/${locale}/blog/`}
      class="text-sm text-[var(--color-text-muted)] underline underline-offset-4 hover:text-[var(--color-text)]"
    >
      ← {t('blog.backToBlog')}
    </a>

    <article class="mt-8">
      <h1 class="text-marketing-h1 text-[var(--color-text)]">{post.data.title}</h1>

      <p class="mt-4 text-sm text-[var(--color-text-muted)]">
        <time datetime={post.data.pubDate.toISOString()}>
          {t('blog.publishedOn')} {dateFmt.format(post.data.pubDate)}
        </time>
        {post.data.updatedDate && (
          <>
            {' · '}
            <time datetime={post.data.updatedDate.toISOString()}>
              {t('blog.updatedOn')} {dateFmt.format(post.data.updatedDate)}
            </time>
          </>
        )}
      </p>

      <div class="prose prose-sm mt-10 max-w-none text-[var(--color-text-muted)]">
        <Content />
      </div>
    </article>

    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  </Section>
</BaseLayout>
