---
import { isLocale, type Locale } from '~/i18n';
import IntegratorsBody from '~/components/pages/IntegratorsBody.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'es-mx' } }, { params: { lang: 'pt' } }, { params: { lang: 'pt-br' } }];
}

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/es/', 308);
const locale = lang as Locale;
---

<IntegratorsBody locale={locale} />
