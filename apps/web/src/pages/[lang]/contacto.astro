---
import { isLocale, useTranslations, type Locale } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '@dentalpin/ui/Section.astro';
import ContactForm from '~/components/ContactForm.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}
const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/es/', 308);
const locale = lang as Locale;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={`${t('contact.title')} · Dentalpin`}>
  <Section maxWidth="narrow" padY="lg">
    <div class="mb-8">
      <h1 class="text-marketing-h1 text-[var(--color-text)]">{t('contact.title')}</h1>
      <p class="mt-3 text-[15px] text-[var(--color-text-muted)]">{t('contact.subtitle')}</p>
    </div>
    <ContactForm locale={locale} />
  </Section>
</BaseLayout>
