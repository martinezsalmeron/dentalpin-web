---
import { isLocale, type Locale } from '~/i18n';
import ContactBody from '~/components/pages/ContactBody.astro';

export function getStaticPaths() {
  // PT shares the Spanish slug. Brazil does not: it writes "contato", and
  // gets its own file.
  return [{ params: { lang: 'es' } }, { params: { lang: 'pt' } }, { params: { lang: 'es-mx' } }];
}

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/es/', 308);
const locale = lang as Locale;
---

<ContactBody locale={locale} />
