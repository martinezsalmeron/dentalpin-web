---
import { isLocale, pagePath, type Locale } from '~/i18n';
import FeatureDetailBody from '~/components/pages/FeatureDetailBody.astro';
import { MODULES, moduleBySlug } from '~/data/modules';

export function getStaticPaths() {
  return MODULES.map((m) => ({
    params: { lang: 'es', slug: m.slug },
  }));
}

const { lang, slug } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/es/', 308);
const locale = lang as Locale;
const mod = moduleBySlug(slug!);
if (!mod) return Astro.redirect(pagePath(locale, 'features'), 308);
---

<FeatureDetailBody locale={locale} mod={mod} />
