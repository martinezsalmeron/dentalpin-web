---
import { isLocale, type Locale } from '~/i18n';
import ManifestoBody from '~/components/pages/ManifestoBody.astro';

export function getStaticPaths() {
  // PT shares the English slug, so it hangs off this file rather than its own.
  return [{ params: { lang: 'en' } }, { params: { lang: 'pt' } }];
}

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/es/', 308);
const locale = lang as Locale;
---

<ManifestoBody locale={locale} />
