---
import { isLocale, type Locale } from '~/i18n';
import FeaturesIndexBody from '~/components/pages/FeaturesIndexBody.astro';

export function getStaticPaths() {
  // PT shares the Spanish slug, and both regional variants share their
  // parent's, so all four hang off this file.
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'pt-br' } },
    { params: { lang: 'es-mx' } },
  ];
}

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/es/', 308);
const locale = lang as Locale;
---

<FeaturesIndexBody locale={locale} />
