---
import { isLocale, type Locale } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import DayInClinic from '~/components/DayInClinic.astro';
import VsLegacy from '~/components/VsLegacy.astro';
import BentoFeatures from '~/components/BentoFeatures.astro';
import WhereYouWork from '~/components/WhereYouWork.astro';
import HomeManifesto from '~/components/HomeManifesto.astro';
import LiveDemoCard from '~/components/LiveDemoCard.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/es/', 308);
const locale = lang as Locale;
---

<BaseLayout locale={locale}>
  <Hero locale={locale} />
  <DayInClinic locale={locale} />
  <VsLegacy locale={locale} />
  <BentoFeatures locale={locale} />
  <WhereYouWork locale={locale} />
  <HomeManifesto locale={locale} />
  <LiveDemoCard locale={locale} />
</BaseLayout>
