---
import { isLocale, type Locale } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import PillarsStrip from '~/components/PillarsStrip.astro';
import WhereYouWork from '~/components/WhereYouWork.astro';
import DayInClinic from '~/components/DayInClinic.astro';
import LiveModulesGrid from '~/components/LiveModulesGrid.astro';
import VerifactuCallout from '~/components/VerifactuCallout.astro';
import ForDevelopers from '~/components/ForDevelopers.astro';
import LiveDemoCard from '~/components/LiveDemoCard.astro';
import SectionAnchor from '~/components/SectionAnchor.astro';
import ToothScrollIndicator from '~/components/ToothScrollIndicator.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/es/', 308);
const locale = lang as Locale;
---

<BaseLayout locale={locale}>
  <SectionAnchor fdi="11" />
  <Hero locale={locale} />

  <SectionAnchor fdi="12" />
  <PillarsStrip locale={locale} />

  <SectionAnchor fdi="13" />
  <WhereYouWork locale={locale} />

  <SectionAnchor fdi="14" />
  <DayInClinic locale={locale} />

  <SectionAnchor fdi="15" />
  <LiveModulesGrid locale={locale} />

  {locale === 'es' && (
    <>
      <SectionAnchor fdi="16" />
      <VerifactuCallout locale={locale} />
    </>
  )}

  <SectionAnchor fdi="17" />
  <ForDevelopers locale={locale} />

  <SectionAnchor fdi="18" />
  <LiveDemoCard locale={locale} />

  <ToothScrollIndicator />
</BaseLayout>
