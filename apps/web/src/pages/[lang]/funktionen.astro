---
import { isLocale, type Locale } from '~/i18n';
import FeaturesIndexBody from '~/components/pages/FeaturesIndexBody.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'de' } }];
}

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/es/', 308);
const locale = lang as Locale;
---

<FeaturesIndexBody locale={locale} />
