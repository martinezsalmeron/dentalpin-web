PUBLIC_SITE_URL=https://www.dentalpin.com

# Resend (required for /api/contact)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=ventas@dentalpin.com
CONTACT_FROM_EMAIL=no-reply@dentalpin.com

# Brevo needs no config: the mailing list is reached through its hosted form
# endpoint, which carries the list in its token. See BREVO_FORM_ACTION in
# src/config/links.ts.

# Cloudflare Turnstile (optional — disables check when unset)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Sentry (optional)
PUBLIC_SENTRY_DSN=
