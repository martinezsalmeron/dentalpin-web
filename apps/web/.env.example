PUBLIC_SITE_URL=https://www.dentalpin.com

# Resend (required for /api/contact)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=ventas@dentalpin.com
CONTACT_FROM_EMAIL=no-reply@dentalpin.com
# Resend Audience every submitted email joins. Create it at
# resend.com/audiences. Unset means leads are emailed but never listed.
RESEND_AUDIENCE_ID=

# Cloudflare Turnstile (optional — disables check when unset)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Sentry (optional)
PUBLIC_SENTRY_DSN=
